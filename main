    return {
        "inline_keyboard": [
            [{"text": "Да, деньги пришли", "callback_data": f"confirm_payment_{order_id}", "style": "success", "icon_custom_emoji_id": E_CHECK}],
            [{"text": "Нет, отменить заказ", "callback_data": f"reject_payment_{order_id}", "style": "danger", "icon_custom_emoji_id": E_CROSS}]
        ]
    }

def owner_done_menu(order_id):
    return {
        "inline_keyboard": [
            [{"text": "Я выполнил заказ", "callback_data": f"order_done_{order_id}", "style": "success", "icon_custom_emoji_id": E_CHECK}]
        ]
    }

def after_payment_menu():
    return {
        "inline_keyboard": [
            [{"text": "Отменить заказ", "callback_data": "cancel_payment", "style": "danger", "icon_custom_emoji_id": E_CROSS}]
        ]
    }

# ========== ОСНОВНАЯ ОБРАБОТКА ==========

def handle_update(update):
    try:
        # ---- СООБЩЕНИЯ ----
        if "message" in update:
            msg = update["message"]
            chat_id = msg["chat"]["id"]
            text = msg.get("text", "")
            user_id = str(chat_id)
            
            if user_id not in user_data:
                user_data[user_id] = {"cart": {}, "step": "main", "temp": {}, "last_message_id": None}
            
            if text == "/start":
                try:
                    send_photo(
                        chat_id,
                        PHOTO_URL,
                        caption=(
                            f'<tg-emoji emoji-id="{E_WELCOME}">👋</tg-emoji> '
                            f'Добро пожаловать в KRANZAYY UC BOT!\n\nВыберите действие:'
                        ),
                        reply_markup=main_menu()
                    )
                except:
                    send_message(
                        chat_id,
                        f'<tg-emoji emoji-id="{E_WELCOME}">👋</tg-emoji> '
                        f'Добро пожаловать в KRANZAYY UC BOT!\n\nВыберите действие:',
                        main_menu()
                    )
                return
            
            if user_data[user_id].get("step") == "waiting_pubg_id":
                pubg_id = text.strip()
                if not pubg_id.isdigit() or len(pubg_id) < 5:
                    send_message(
                        chat_id,
                        f'<tg-emoji emoji-id="{E_CROSS}">❌</tg-emoji> Неверный формат. Введите только цифры (минимум 5):',
                        after_payment_menu()
                    )
                    return
                
                user_data[user_id]["temp"]["pubg_id"] = pubg_id
                user_data[user_id]["step"] = "main"
                
                cart = user_data[user_id]["cart"]
                total_uc, total_price = get_cart_total(cart)
                username = get_user_name(chat_id)
                
                cart_text = ""
                for k, v in cart.items():
                    if k.startswith("pop_"):
                        amount = k.replace("pop_", "")
                        cart_text += f"• {amount} ПП x {v} = {POPULARITY_PRICES.get(amount, 0) * v}₽\n"
                    else:
                        cart_text += f"• {k} UC x {v} = {UC_PRICES.get(k, 0) * v}₽\n"
                
                order_id = f"{chat_id}_{int(time.time())}"
                owner_text = (
                    f'<tg-emoji emoji-id="{E_CART}">📦</tg-emoji> <b>НОВЫЙ ЗАКАЗ</b>\n\n'
                    f'<tg-emoji emoji-id="{E_STAR}">👤</tg-emoji> Покупатель: {username}\n'
                    f'<tg-emoji emoji-id="{E_PIN}">🆔</tg-emoji> PUBG ID: {pubg_id}\n'
                    f'<tg-emoji emoji-id="{E_CART}">📦</tg-emoji> Товары:\n{cart_text}\n'
                    f'<tg-emoji emoji-id="{E_UC}">💰</tg-emoji> Итого: {total_price}₽'
                )
                
                send_message(OWNER_ID, owner_text, owner_done_menu(order_id), parse_mode="HTML")
                
                orders[order_id] = {
                    "user_id": chat_id,
                    "cart": cart.copy(),
                    "total_uc": total_uc,
                    "total_price": total_price,
                    "username": username,
                    "pubg_id": pubg_id
                }
                
                user_data[user_id]["cart"] = {}
                
                send_message(
                    chat_id,
                    f'<tg-emoji emoji-id="{E_CHECK}">✅</tg-emoji> Заказ подтверждён!\n\n'
                    f'<tg-emoji emoji-id="{E_PIN}">🆔</tg-emoji> Ваш PUBG ID: {pubg_id}\n'
                    f'<tg-emoji emoji-id="{E_TIME}">⏳</tg-emoji> Время доставки: от 5 до 30 минут',
                    main_menu()
                )
                return
        
        # ---- КНОПКИ ----
        elif "callback_query" in update:
            cb = update["callback_query"]
            chat_id = cb["message"]["chat"]["id"]
            data = cb["data"]
            cb_id = cb["id"]
            user_id = str(chat_id)
            
            if user_id not in user_data:
                user_data[user_id] = {"cart": {}, "step": "main", "temp": {}, "last_message_id": None}
            
            logger.info(f"🖱 Нажата кнопка: {data}")
            
            answer_callback(cb_id)
            
            # ---- НАЗАД ----
            if data == "back_to_main":
                send_message(
                    chat_id,
                    f'<tg-emoji emoji-id="{E_WELCOME}">👋</tg-emoji> Главное меню:',
                    main_menu()
                )
                return
            
            # ---- UC ----
            if data == "buy_uc":
                send_message(
                    chat_id,
                    format_cart_text(user_data[user_id]["cart"]),
                    cart_menu()
                )
                return
            
            if data.startswith("add_"):
                amount = data.split("_")[1]
                user_data[user_id]["cart"][amount] = user_data[user_id]["cart"].get(amount, 0) + 1
                send_message(
                    chat_id,
                    format_cart_text(user_data[user_id]["cart"]),
                    cart_menu()
                )
                return
            
            if data == "clear_cart":
                user_data[user_id]["cart"] = {}
                send_message(
                    chat_id,
                    f'<tg-emoji emoji-id="{E_CART}">🛒</tg-emoji> Корзина очищена!',
                    cart_menu()
                )
                return
            
            if data == "checkout":
                cart = user_data[user_id]["cart"]
                if not cart:
                    send_message(
                        chat_id,
                        f'<tg-emoji emoji-id="{E_CROSS}">❌</tg-emoji> Корзина пуста!',
                        cart_menu()
                    )
                    return
                
                total_uc, total_price = get_cart_total(cart)
                cart_text = ""
                for k, v in cart.items():
                    if k.startswith("pop_"):
                        amount = k.replace("pop_", "")
                        cart_text += f"• {amount} ПП x {v} = {POPULARITY_PRICES.get(amount, 0) * v}₽\n"
                    else:
                        cart_text += f"• {k} UC x {v} = {UC_PRICES.get(k, 0) * v}₽\n"
                
                payment_text = (
                    f'<tg-emoji emoji-id="{E_CARD}">💳</tg-emoji> <b>Оплата заказа</b>\n\n'
                    f'<tg-emoji emoji-id="{E_CART}">📦</tg-emoji> Товары:\n{cart_text}\n'
                    f'<tg-emoji emoji-id="{E_UC}">💰</tg-emoji> Итого: {total_price}₽\n\n'
                    f'<b>Способы оплаты:</b>\n\n'
                    f'<tg-emoji emoji-id="{E_CARD}">💳</tg-emoji> <b>Карта Сбербанк:</b>\n'
                    f'<code>2202208555983213</code>\n\n'
                    f'<tg-emoji emoji-id="{E_PHONE}">📱</tg-emoji> <b>По номеру телефона:</b>\n'
                    f'<code>+7 952 321-66-09</code>'
                )
                
                send_message(chat_id, payment_text, payment_menu(), parse_mode="HTML")
                return
            
            # ---- ОПЛАТА ----
            if data == "copy_card":
                send_message(chat_id, '<code>2202208555983213</code>', parse_mode="HTML")
                return
            
            if data == "copy_phone":
                send_message(chat_id, '<code>+7 952 321-66-09</code>', parse_mode="HTML")
                return
            
            if data == "i_paid":
                cart = user_data[user_id]["cart"]
                if not cart:
                    send_message(
                        chat_id,
                        f'<tg-emoji emoji-id="{E_CROSS}">❌</tg-emoji> Корзина пуста!',
                        main_menu()
                    )
                    return
                
                total_uc, total_price = get_cart_total(cart)
                username = get_user_name(chat_id)
                
                cart_text = ""
                for k, v in cart.items():
                    if k.startswith("pop_"):
                        amount = k.replace("pop_", "")
                        cart_text += f"• {amount} ПП x {v} = {POPULARITY_PRICES.get(amount, 0) * v}₽\n"
                    else:
                        cart_text += f"• {k} UC x {v} = {UC_PRICES.get(k, 0) * v}₽\n"
                
                order_id = f"{chat_id}_{int(time.time())}"
                orders[order_id] = {
                    "user_id": chat_id,
                    "cart": cart.copy(),
                    "total_uc": total_uc,
                    "total_price": total_price,
                    "username": username,
                    "status": "waiting_confirmation"
                }
                
                owner_text = (
                    f'<tg-emoji emoji-id="{E_UC}">💰</tg-emoji> <b>ПОДТВЕРЖДЕНИЕ ОПЛАТЫ</b>\n\n'
                    f'<tg-emoji emoji-id="{E_STAR}">👤</tg-emoji> Покупатель: {username}\n'
                    f'<tg-emoji emoji-id="{E_CART}">📦</tg-emoji> Товары:\n{cart_text}\n'
                    f'<tg-emoji emoji-id="{E_UC}">💰</tg-emoji> Итого: {total_price}₽'
                )
                
                send_message(OWNER_ID, owner_text, owner_confirm_menu(order_id), parse_mode="HTML")
                
                send_message(
                    chat_id,
                    f'<tg-emoji emoji-id="{E_TIME}">⏳</tg-emoji> Ожидайте подтверждения оплаты...',
                    main_menu()
                )
                return
            
            if data == "cancel_payment":
                user_data[user_id]["cart"] = {}
                user_data[user_id]["step"] = "main"
                user_data[user_id]["temp"] = {}
                send_message(
                    chat_id,
                    f'<tg-emoji emoji-id="{E_CROSS}">❌</tg-emoji> Заказ отменён',
                    main_menu()
                )
                return
            
            # ---- ПОДТВЕРЖДЕНИЕ ОТ ВЛАДЕЛЬЦА ----
            if data.startswith("confirm_payment_"):
                order_id = data.replace("confirm_payment_", "")
                order = orders.get(order_id)
                if not order:
                    send_message(
                        chat_id,
                        f'<tg-emoji emoji-id="{E_CROSS}">❌</tg-emoji> Заказ не найден',
                        main_menu()
                    )
                    return
                
                user_id = order["user_id"]
                total_price = order["total_price"]
                total_uc = order["total_uc"]
                
                send_message(
                    user_id,
                    f'<tg-emoji emoji-id="{E_CHECK}">✅</tg-emoji> <b>Оплата подтверждена!</b>\n\n'
                    f'<tg-emoji emoji-id="{E_CART}">📦</tg-emoji> Товар: {total_uc} UC\n'
                    f'<tg-emoji emoji-id="{E_UC}">💰</tg-emoji> Сумма: {total_price}₽\n\n'
                    f'<tg-emoji emoji-id="{E_PIN}">🆔</tg-emoji> <b>Введите ваш PUBG ID:</b>\n'
                    f'<tg-emoji emoji-id="{E_WARNING}">⚠️</tg-emoji> Указывайте ID осторожно!',
                    after_payment_menu(),
                    parse_mode="HTML"
                )
                
                user_data[str(user_id)]["step"] = "waiting_pubg_id"
                user_data[str(user_id)]["temp"]["order_id"] = order_id
                
                send_message(
                    chat_id,
                    f'<tg-emoji emoji-id="{E_CHECK}">✅</tg-emoji> Пользователь уведомлён',
                    main_menu()
                )
                return
            
            if data.startswith("reject_payment_"):
                order_id = data.replace("reject_payment_", "")
                order = orders.get(order_id)
                if not order:
                    send_message(
                        chat_id,
                        f'<tg-emoji emoji-id="{E_CROSS}">❌</tg-emoji> Заказ не найден',
                        main_menu()
                    )
                    return
                
                user_id = order["user_id"]
                
                send_message(
                    user_id,
                    f'<tg-emoji emoji-id="{E_CROSS}">❌</tg-emoji> <b>Оплата не подтверждена</b>\n\n'
                    f'К сожалению, мы не получили ваш платёж.\n'
                    f'Заказ отменён.',
                    main_menu(),
                    parse_mode="HTML"
                )
                
                user_data[str(user_id)]["cart"] = {}
                user_data[str(user_id)]["step"] = "main"
                user_data[str(user_id)]["temp"] = {}
                
                send_message(
                    chat_id,
                    f'<tg-emoji emoji-id="{E_CROSS}">❌</tg-emoji> Заказ отменён',
                    main_menu()
                )
                return
            
            # ---- ВЫПОЛНЕНИЕ ЗАКАЗА ----
            if data.startswith("order_done_"):
                order_id = data.replace("order_done_", "")
                order = orders.get(order_id)
                if not order:
                    send_message(
                        chat_id,
                        f'<tg-emoji emoji-id="{E_CROSS}">❌</tg-emoji> Заказ не найден',
                        main_menu()
                    )
                    return
                
                user_id = order["user_id"]
                total_uc = order["total_uc"]
                pubg_id = user_data[str(user_id)].get("temp", {}).get("pubg_id", "Не указан")
                
                send_message(
                    user_id,
                    f'<tg-emoji emoji-id="{E_CHECK}">✅</tg-emoji> <b>Ваш заказ выполнен!</b>\n\n'
                    f'<tg-emoji emoji-id="{E_CART}">📦</tg-emoji> Товар: {total_uc} UC\n'
                    f'<tg-emoji emoji-id="{E_PIN}">🆔</tg-emoji> PUBG ID: {pubg_id}\n\n'
                    f'<tg-emoji emoji-id="{E_STAR}">⭐</tg-emoji> Спасибо за покупку!',
                    main_menu(),
                    parse_mode="HTML"
                )
                
                send_message(
                    chat_id,
                    f'<tg-emoji emoji-id="{E_CHECK}">✅</tg-emoji> Заказ выполнен!',
                    main_menu()
                )
                
                user_data[str(user_id)]["cart"] = {}
                user_data[str(user_id)]["step"] = "main"
                user_data[str(user_id)]["temp"] = {}
                return
            
            # ---- ПОПУЛЯРНОСТЬ ----
            if data == "popularity":
                send_message(
                    chat_id,
                    f'<tg-emoji emoji-id="{E_STAR}">⭐️</tg-emoji> Выберите количество популярности:',
                    popularity_menu()
                )
                return
            
            if data.startswith("pop_"):
                amount = data.split("_")[1]
                formatted = f"{int(amount):,}".replace(",", " ")
                price = POPULARITY_PRICES.get(amount, 0)
                
                user_data[user_id]["cart"][f"pop_{amount}"] = user_data[user_id]["cart"].get(f"pop_{amount}", 0) + 1
                
                send_message(
                    chat_id,
                    f'<tg-emoji emoji-id="{E_CHECK}">✅</tg-emoji> Вы выбрали {formatted} ПП - {price}₽\n\n'
                    f'<tg-emoji emoji-id="{E_TIME}">⏳</tg-emoji> Время доставки: от 5 до 30 минут',
                    main_menu()
                )
                return
            
            # ---- ИНФОРМАЦИЯ (БЕЗ НЕРАБОЧИХ ЭМОДЗИ) ----
            if data == "info":
                text = (
                    f'<tg-emoji emoji-id="{E_INFO}">ℹ️</tg-emoji> KRANZAYY UC BOT\n\n'
                    "Наш бот работает для вас ❤️‍🔥\n\n"
                    "Наши ресурсы:\n"
                    "🛒 Магазин - https://t.me/kranzayyuc\n"
                    "📢 Канал - https://t.me/KRANZAYY_STORE\n"
                    "🏪 Метро шоп - https://t.me/MetroShop_Kranzayy\n"
                    "⭐ Отзывы - https://t.me/Kranzayy_OTZ\n\n"
                    "🆘 Техническая поддержка: @M_K_B_59"
                )
                send_message(chat_id, text, main_menu(), parse_mode="HTML")
                return
            
            # ---- НЕИЗВЕСТНО ----
            logger.warning(f"⚠️ Неизвестная кнопка: {data}")
            send_message(
                chat_id,
                f'<tg-emoji emoji-id="{E_CROSS}">❌</tg-emoji> Неизвестная команда',
                main_menu()
            )
    
    except Exception as e:
        logger.error(f"💥 ОШИБКА: {e}")
        logger.error(traceback.format_exc())

# ========== ЗАПУСК ==========

def main():
    offset = None
    logger.info("=" * 50)
    logger.info("🚀 БОТ ЗАПУЩЕН")
    logger.info(f"👤 Владелец: {OWNER_ID}")
    logger.info("=" * 50)
    
    while True:
        try:
            response = requests.get(
                f"{BASE_URL}/getUpdates",
                params={"timeout": 30, "offset": offset},
                timeout=35
            ).json()
            
            if response.get("ok"):
                for update in response.get("result", []):
                    handle_update(update)
                    offset = update["update_id"] + 1
            else:
                logger.error(f"❌ Ошибка: {response}")
            
            time.sleep(0.5)
        except Exception as e:
            logger.error(f"💥 Ошибка: {e}")
            time.sleep(10)

if __name__ == "__main__":
    main()
