# ========== ОБРАБОТКА ==========

def handle_update(update):
    try:
        logger.debug(f"📩 Получен update ID: {update.get('update_id', 'unknown')}")
        
        # ===== СООБЩЕНИЯ =====
        if "message" in update:
            msg = update["message"]
            chat_id = msg["chat"]["id"]
            text = msg.get("text", "")
            logger.info(f"💬 Сообщение от {chat_id}: {text[:100]}")
            
            if text == "/start":
                logger.info(f"🔄 Отправка главного меню в чат {chat_id}")
                
                # Пробуем отправить фото
                try:
                    result = send_photo(
                        chat_id,
                        PHOTO_URL,
                        caption="👋 Добро пожаловать в KRANZAYY UC BOT!\n\nВыберите действие:",
                        reply_markup=main_menu()
                    )
                    if result.get("ok"):
                        logger.info(f"✅ Фото успешно отправлено")
                    else:
                        logger.error(f"❌ Ошибка фото: {result}")
                        send_message(chat_id, "👋 Добро пожаловать в KRANZAYY UC BOT!\n\nВыберите действие:", main_menu())
                except Exception as e:
                    logger.error(f"❌ Исключение при фото: {e}")
                    send_message(chat_id, "👋 Добро пожаловать в KRANZAYY UC BOT!\n\nВыберите действие:", main_menu())
            return
        
        # ===== КНОПКИ =====
        elif "callback_query" in update:
            cb = update["callback_query"]
            chat_id = cb["message"]["chat"]["id"]
            message_id = cb["message"]["message_id"]
            data = cb["data"]
            cb_id = cb["id"]
            
            logger.info(f"🖱 Нажата кнопка: {data} от {chat_id}")
            
            # ---- НАЗАД ----
            if data == "back_to_main":
                logger.debug("↩️ Возврат в главное меню")
                result = edit_message(chat_id, message_id, "👋 Главное меню:", main_menu())
                if not result.get("ok"):
                    logger.error(f"❌ Ошибка edit_message: {result}")
                answer_callback(cb_id)
                return
            
            # ---- UC ----
            if data == "buy_uc":
                logger.debug("🛒 Открытие корзины")
                result = edit_message(chat_id, message_id, "🛒 Выберите количество UC:", cart_menu())
                if not result.get("ok"):
                    logger.error(f"❌ Ошибка edit_message: {result}")
                answer_callback(cb_id)
                return
            
            if data.startswith("add_"):
                amount = data.split("_")[1]
                logger.info(f"➕ Добавлено {amount} UC")
                answer_callback(cb_id, f"✅ +{amount} UC!")
                result = edit_message(chat_id, message_id, f"✅ {amount} UC добавлено в корзину!", cart_menu())
                if not result.get("ok"):
                    logger.error(f"❌ Ошибка edit_message: {result}")
                return
            
            if data == "clear_cart":
                logger.info("🗑 Очистка корзины")
                answer_callback(cb_id, "🗑 Корзина очищена!")
                result = edit_message(chat_id, message_id, "🛒 Корзина пуста", cart_menu())
                if not result.get("ok"):
                    logger.error(f"❌ Ошибка edit_message: {result}")
                return
            
            if data == "checkout":
                logger.info("✅ Оформление заказа")
                answer_callback(cb_id, "✅ Заказ оформлен!")
                send_message(chat_id, "✅ Заказ оформлен!\nОжидайте подтверждения оператора.")
                result = edit_message(chat_id, message_id, "🛒 Заказ оформлен", cart_menu())
                if not result.get("ok"):
                    logger.error(f"❌ Ошибка edit_message: {result}")
                return
            
            # ---- ПОПУЛЯРНОСТЬ ----
            if data == "popularity":
                logger.debug("⭐️ Открытие меню популярности")
                result = edit_message(chat_id, message_id, "⭐️ Выберите количество популярности:", popularity_menu())
                if not result.get("ok"):
                    logger.error(f"❌ Ошибка edit_message: {result}")
                answer_callback(cb_id)
                return
            
            if data.startswith("pop_"):
                amount = data.split("_")[1]
                formatted = f"{int(amount):,}".replace(",", " ")
                logger.info(f"⭐️ Выбрано {formatted} ПП")
                answer_callback(cb_id, f"✅ Выбрано {formatted} ПП!")
                send_message(chat_id, f"✅ Вы выбрали {formatted} ПП\n\nОжидайте, оператор свяжется с вами!\n\n🆘 Поддержка: @M_K_B_59")
                result = edit_message(chat_id, message_id, f"✅ Выбрано {formatted} ПП", popularity_menu())
                if not result.get("ok"):
                    logger.error(f"❌ Ошибка edit_message: {result}")
                return
            
            # ---- ИНФОРМАЦИЯ ----
            if data == "info":
                logger.info("ℹ️ Открытие информации")
                text = (
                    "ℹ️ KRANZAYY UC BOT\n\n"
                    "Наш бот работает для вас "
                    f'<tg-emoji emoji-id="{EMOJI_HEART}">❤️‍🔥</tg-emoji>\n\n'
                    f'<tg-emoji emoji-id="{EMOJI_FIRE}">🌟</tg-emoji>'
                    f'<tg-emoji emoji-id="{EMOJI_SPARKLE}">✨</tg-emoji>'
                    f'<tg-emoji emoji-id="{EMOJI_SPARKLE}">✨</tg-emoji>'
                    f'<tg-emoji emoji-id="{EMOJI_STAR2}">💫</tg-emoji>\n\n'
                    "📌 Наши ресурсы:\n"
                    f'<tg-emoji emoji-id="{EMOJI_SHOP}">🛒</tg-emoji> Магазин - https://t.me/kranzayyuc\n'
                    f'<tg-emoji emoji-id="{EMOJI_MEGAPHONE}">📢</tg-emoji> Канал - https://t.me/KRANZAYY_STORE\n'
                    f'<tg-emoji emoji-id="{EMOJI_METRO}">🏪</tg-emoji> Метро шоп - https://t.me/MetroShop_Kranzayy\n'
                    f'<tg-emoji emoji-id="{EMOJI_REVIEW}">⭐</tg-emoji> Отзывы - https://t.me/Kranzayy_OTZ\n\n'
                    f'<tg-emoji emoji-id="{EMOJI_DIAMOND}">💎</tg-emoji>'
                    f'<tg-emoji emoji-id="{EMOJI_DIAMOND}">💎</tg-emoji>'
                    f'<tg-emoji emoji-id="{EMOJI_DIAMOND}">💎</tg-emoji>'
                    f'<tg-emoji emoji-id="{EMOJI_DIAMOND}">💎</tg-emoji>\n\n'
                    f'<tg-emoji emoji-id="{EMOJI_SUPPORT}">🆘</tg-emoji> Техническая поддержка: @M_K_B_59'
