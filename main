# ========== ОСНОВНЫЕ ФУНКЦИИ ==========
def send_message(chat_id, text, reply_markup=None, parse_mode="HTML"):
    """Отправка сообщения"""
    url = f"{BASE_URL}/sendMessage"
    payload = {
        "chat_id": chat_id,
        "text": text,
        "parse_mode": parse_mode
    }
    if reply_markup:
        payload["reply_markup"] = json.dumps(reply_markup)
    response = requests.post(url, json=payload)
    return response.json()

def send_photo(chat_id, photo_url, caption=None, reply_markup=None, parse_mode="HTML"):
    """Отправка фото"""
    url = f"{BASE_URL}/sendPhoto"
    payload = {
        "chat_id": chat_id,
        "photo": photo_url,
        "parse_mode": parse_mode
    }
    if caption:
        payload["caption"] = caption
    if reply_markup:
        payload["reply_markup"] = json.dumps(reply_markup)
    response = requests.post(url, json=payload)
    return response.json()

def edit_message(chat_id, message_id, text, reply_markup=None, parse_mode="HTML"):
    """Редактирование сообщения"""
    url = f"{BASE_URL}/editMessageText"
    payload = {
        "chat_id": chat_id,
        "message_id": message_id,
        "text": text,
        "parse_mode": parse_mode
    }
    if reply_markup:
        payload["reply_markup"] = json.dumps(reply_markup)
    response = requests.post(url, json=payload)
    return response.json()

def answer_callback(callback_id, text=None, show_alert=False):
    """Ответ на callback"""
    url = f"{BASE_URL}/answerCallbackQuery"
    payload = {"callback_query_id": callback_id}
    if text:
        payload["text"] = text
    if show_alert:
        payload["show_alert"] = True
    response = requests.post(url, json=payload)
    return response.json()

def delete_message(chat_id, message_id):
    """Удаление сообщения"""
    url = f"{BASE_URL}/deleteMessage"
    payload = {"chat_id": chat_id, "message_id": message_id}
    response = requests.post(url, json=payload)
    return response.json()

def get_cart_total(cart):
    """Подсчёт итогов корзины"""
    total_uc = 0
    total_price = 0
    for amount, count in cart.items():
        price = UC_PRICES.get(amount, 0)
        total_uc += int(amount) * count
        total_price += price * count
    return total_uc, total_price

def format_price(price):
    """Форматирование цены"""
    return f"{price:.2f}".replace(".", ",")

