# ========== ХРАНИЛИЩЕ ==========
user_data = {}      # {user_id: {"cart": {}, "step": "", "temp": {}, "last_message_id": None}}
orders = {}         # {order_id: {...}}

# ========== ФУНКЦИИ ==========
def api_request(method, payload):
    url = f"{BASE_URL}/{method}"
    try:
        response = requests.post(url, json=payload, timeout=30)
        result = response.json()
        if not result.get("ok"):
            logger.error(f"❌ Ошибка {method}: {result.get('description', '')}")
        return result
    except Exception as e:
        logger.error(f"💥 {method}: {e}")
        return {"ok": False, "error": str(e)}

def send_message(chat_id, text, reply_markup=None, parse_mode="HTML"):
    payload = {"chat_id": chat_id, "text": text, "parse_mode": parse_mode}
    if reply_markup:
        payload["reply_markup"] = json.dumps(reply_markup)
    result = api_request("sendMessage", payload)
    
    # Сохраняем ID отправленного сообщения для удаления
    if result.get("ok"):
        message_id = result.get("result", {}).get("message_id")
        if message_id:
            user_id = str(chat_id)
            if user_id not in user_data:
                user_data[user_id] = {"cart": {}, "step": "main", "temp": {}, "last_message_id": None}
            
            # Удаляем предыдущее сообщение пользователя
            if user_data[user_id].get("last_message_id"):
                try:
                    delete_message(chat_id, user_data[user_id]["last_message_id"])
                except:
                    pass
            
            user_data[user_id]["last_message_id"] = message_id
    
    return result

def send_photo(chat_id, photo, caption=None, reply_markup=None, parse_mode="HTML"):
    payload = {"chat_id": chat_id, "photo": photo, "parse_mode": parse_mode}
    if caption:
        payload["caption"] = caption
    if reply_markup:
        payload["reply_markup"] = json.dumps(reply_markup)
    result = api_request("sendPhoto", payload)
    
    if result.get("ok"):
        message_id = result.get("result", {}).get("message_id")
        if message_id:
            user_id = str(chat_id)
            if user_id not in user_data:
                user_data[user_id] = {"cart": {}, "step": "main", "temp": {}, "last_message_id": None}
            
            if user_data[user_id].get("last_message_id"):
                try:
                    delete_message(chat_id, user_data[user_id]["last_message_id"])
                except:
                    pass
            
            user_data[user_id]["last_message_id"] = message_id
    
    return result

def delete_message(chat_id, message_id):
    payload = {"chat_id": chat_id, "message_id": message_id}
    return api_request("deleteMessage", payload)

def answer_callback(callback_id, text=None, show_alert=False):
    payload = {"callback_query_id": callback_id}
    if text:
        payload["text"] = text
    if show_alert:
        payload["show_alert"] = True
    return api_request("answerCallbackQuery", payload)

def get_user_name(chat_id):
    try:
        result = api_request("getChat", {"chat_id": chat_id})
        if result.get("ok"):
            user = result.get("result", {})
            username = user.get("username")
            if username:
                return f"@{username}"
            return user.get("first_name", "Пользователь")
        return "Пользователь"
    except:
        return "Пользователь"

def get_cart_total(cart):
    total_uc = 0
    total_price = 0
    for k, v in cart.items():
        if k.startswith("pop_"):
            amount = k.replace("pop_", "")
            total_price += POPULARITY_PRICES.get(amount, 0) * v
        else:
            total_uc += int(k) * v
            total_price += UC_PRICES.get(k, 0) * v
    return total_uc, total_price

def format_cart_text(cart):
    if not cart:
        return f'<tg-emoji emoji-id="{E_CART}">🛒</tg-emoji> Корзина пуста'
    
    text = f'<tg-emoji emoji-id="{E_CART}">🛒</tg-emoji> Ваша корзина:\n\n'
    for k, v in cart.items():
        if k.startswith("pop_"):
            amount = k.replace("pop_", "")
            price = POPULARITY_PRICES.get(amount, 0)
            text += f'<tg-emoji emoji-id="{E_STAR}">⭐️</tg-emoji> {amount} ПП x {v} = {price * v}₽\n'
        else:
            price = UC_PRICES.get(k, 0)
            text += f'<tg-emoji emoji-id="{E_UC}">💵</tg-emoji> {k} UC x {v} = {price * v}₽\n'
    
    total_uc, total_price = get_cart_total(cart)
    text += f'\n<tg-emoji emoji-id="{E_UC}">💰</tg-emoji> Итого: {total_uc} UC — {total_price}₽'
    return text

# ========== ЦЕНЫ ==========
UC_PRICES = {"60": 75, "325": 390, "660": 760, "1800": 1990, "3850": 4000, "8100": 8630}
POPULARITY_PRICES = {"10000": 176, "20000": 307, "30000": 439, "40000": 578, "50000": 715, "60000": 857, "70000": 989, "100000": 1375, "150000": 1994, "200000": 2612, "500000": 6272}

