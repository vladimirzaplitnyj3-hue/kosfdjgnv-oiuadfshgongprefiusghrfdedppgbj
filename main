# ========== ОБРАБОТКА ==========

def handle_update(update):
    try:
        if "message" in update:
            msg = update["message"]
            chat_id = msg["chat"]["id"]
            text = msg.get("text", "")
            user_id = str(chat_id)
            
            if user_id not in user_data:
                user_data[user_id] = {"uc_cart": {}, "pop_cart": {}, "step": "main", "temp": {}}
            
            if text == "/start":
                send_message(chat_id, "👋 Добро пожаловать!\nВыберите действие:", main_menu())
                return
            
            if user_data[user_id].get("step") == "waiting_pubg":
                pubg_id = text.strip()
                if not pubg_id.isdigit() or len(pubg_id) < 5:
                    send_message(chat_id, "❌ Неверный формат. Введите только цифры (минимум 5):")
                    return
                
                user_data[user_id]["temp"]["pubg_id"] = pubg_id
                user_data[user_id]["step"] = "main"
                
                order_type = user_data[user_id]["temp"].get("order_type", "UC")
                
                if order_type == "UC":
                    cart = user_data[user_id]["uc_cart"]
                    total = sum(int(k) * v for k, v in cart.items())
                    price = sum(UC_PRICES.get(k, 0) * v for k, v in cart.items())
                else:
                    cart = user_data[user_id]["pop_cart"]
                    total = sum(int(k) * v for k, v in cart.items())
                    price = sum(POP_PRICES.get(k, 0) * v for k, v in cart.items())
                
                order_id = f"{chat_id}_{int(time.time())}"
                orders[order_id] = {
                    "user_id": chat_id,
                    "total": total,
                    "price": price,
                    "order_type": order_type,
                    "pubg_id": pubg_id
                }
                
                # Владельцу
                owner_text = f"📦 НОВЫЙ ЗАКАЗ ({order_type})\n👤 Покупатель: @{get_username(chat_id)}\n🆔 PUBG: {pubg_id}\n💰 Сумма: {price}₽"
                send_message(OWNER_ID, owner_text, done_menu(order_id))
                
                # Покупателю
                send_message(chat_id, f"✅ Заказ подтверждён!\n📦 {total} {order_type}\n💰 {price}₽\n⏳ Доставка 5-30 минут", main_menu())
                
                if order_type == "UC":
                    user_data[user_id]["uc_cart"] = {}
                else:
                    user_data[user_id]["pop_cart"] = {}
                return
        
        elif "callback_query" in update:
            cb = update["callback_query"]
            chat_id = cb["message"]["chat"]["id"]
            message_id = cb["message"]["message_id"]
            data = cb["data"]
            cb_id = cb["id"]
            user_id = str(chat_id)
            
            print(f"🔔 Кнопка: {data}")  # Лог
            
            # ОТВЕТ НА КНОПКУ (ВАЖНО!)
            answer_callback(cb_id, f"✅ {data}")
            
            if user_id not in user_data:
                user_data[user_id] = {"uc_cart": {}, "pop_cart": {}, "step": "main", "temp": {}}
            
            # ---- НАЗАД ----
            if data == "back":
                edit_message(chat_id, message_id, "👋 Главное меню:", main_menu())
                return
            
            # ---- UC ----
            if data == "buy_uc":
                edit_message(chat_id, message_id, "🛒 Корзина UC:", uc_menu())
                return
            
            if data.startswith("uc_") and data != "uc_checkout" and data != "uc_clear":
                amount = data.replace("uc_", "")
                user_data[user_id]["uc_cart"][amount] = user_data[user_id]["uc_cart"].get(amount, 0) + 1
                total = sum(int(k) * v for k, v in user_data[user_id]["uc_cart"].items())
                price = sum(UC_PRICES.get(k, 0) * v for k, v in user_data[user_id]["uc_cart"].items())
                edit_message(chat_id, message_id, f"🛒 Корзина UC\n✅ +{amount} UC\n📦 Итого: {total} UC — {price}₽", uc_menu())
                return
            
            if data == "uc_clear":
                user_data[user_id]["uc_cart"] = {}
                edit_message(chat_id, message_id, "🛒 Корзина UC\n🗑 Очищена", uc_menu())
                return
            
            if data == "uc_checkout":
                cart = user_data[user_id]["uc_cart"]
                if not cart:
                    answer_callback(cb_id, "❌ Корзина пуста!", True)
                    return
                
                user_data[user_id]["temp"]["order_type"] = "UC"
                total = sum(int(k) * v for k, v in cart.items())
                price = sum(UC_PRICES.get(k, 0) * v for k, v in cart.items())
                
                text = f"💳 ОПЛАТА UC\n📦 Товаров: {total} UC\n💰 Сумма: {price}₽\n\n🏦 Сбербанк:\n💳 2202208555983213\n📱 +7 952 321-66-09\n\nНажмите «Я оплатил» после перевода."
                edit_message(chat_id, message_id, text, payment_menu())
                return
            
            # ---- ПОПУЛЯРНОСТЬ ----
            if data == "popularity":
                edit_message(chat_id, message_id, "⭐️ Корзина популярности:", popularity_menu())
                return
            
            if data.startswith("pop_") and data != "pop_checkout" and data != "pop_clear":
                amount = data.replace("pop_", "")
                user_data[user_id]["pop_cart"][amount] = user_data[user_id]["pop_cart"].get(amount, 0) + 1
                total = sum(int(k) * v for k, v in user_data[user_id]["pop_cart"].items())
                price = sum(POP_PRICES.get(k, 0) * v for k, v in user_data[user_id]["pop_cart"].items())
                formatted = f"{int(amount):,}".replace(",", " ")
                edit_message(chat_id, message_id, f"⭐️ Корзина популярности\n✅ +{formatted} ПП\n📦 Итого: {total} ПП — {price}₽", popularity_menu())
                return
            
            if data == "pop_clear":
                user_data[user_id]["pop_cart"] = {}
                edit_message(chat_id, message_id, "⭐️ Корзина популярности\n🗑 Очищена", popularity_menu())
                return
            
            if data == "pop_checkout":
                cart = user_data[user_id]["pop_cart"]
                if not cart:
                    answer_callback(cb_id, "❌ Корзина пуста!", True)
                    return
                
                user_data[user_id]["temp"]["order_type"] = "ПП"
                total = sum(int(k) * v for k, v in cart.items())
                price = sum(POP_PRICES.get(k, 0) * v for k, v in cart.items())
                
                text = f"💳 ОПЛАТА ПОПУЛЯРНОСТИ\n📦 Товаров: {total} ПП\n💰 Сумма: {price}₽\n\n🏦 Сбербанк:\n💳 2202208555983213\n📱 +7 952 321-66-09\n\nНажмите «Я оплатил» после перевода."
                edit_message(chat_id, message_id, text, payment_menu())
                return
            
            # ---- ОПЛАТА ----
            if data == "i_paid":
                order_type = user_data[user_id]["temp"].get("order_type", "UC")
                
                if order_type == "UC":
                    cart = user_data[user_id]["uc_cart"]
                    total = sum(int(k) * v for k, v in cart.items())
                    price = sum(UC_PRICES.get(k, 0) * v for k, v in cart.items())
                else:
                    cart = user_data[user_id]["pop_cart"]
                    total = sum(int(k) * v for k, v in cart.items())
                    price = sum(POP_PRICES.get(k, 0) * v for k, v in cart.items())
                
                username = get_username(chat_id)
                owner_text = f"💰 ПОДТВЕРЖДЕНИЕ ОПЛАТЫ ({order_type})\n👤 {username}\n📦 {total} {order_type}\n💰 {price}₽"
                send_message(OWNER_ID, owner_text)
                
                send_message(chat_id, f"✅ ОПЛАТА ПОДТВЕРЖДЕНА!\n\n🆔 Введите ваш PUBG ID:")
                user_data[user_id]["step"] = "waiting_pubg"
                return
            
            if data == "cancel":
                user_data[user_id]["uc_cart"] = {}
                user_data[user_id]["pop_cart"] = {}
                user_data[user_id]["step"] = "main"
                user_data[user_id]["temp"] = {}
                edit_message(chat_id, message_id, "❌ Заказ отменён", main_menu())
                return
            
            # ---- ВЫПОЛНЕНИЕ ----
            if data.startswith("done_"):
                order_id = data.replace("done_", "")
                order = orders.get(order_id)
                if not order:
                    answer_callback(cb_id, "❌ Заказ не найден", True)
                    return
                
                user_id = order["user_id"]
                total = order["total"]
                order_type = order.get("order_type", "UC")
                pubg_id = order.get("pubg_id", "Не указан")
                
                send_message(user_id, f"🎉 ВАШ ЗАКАЗ ВЫПОЛНЕН!\n📦 {total} {order_type}\n🆔 PUBG: {pubg_id}\n❤️ Спасибо за покупку!", main_menu())
                edit_message(chat_id, message_id, f"✅ Заказ {order_id} выполнен!", main_menu())
                return
            
            # ---- ИНФОРМАЦИЯ ----
            if data == "info":
                text = "ℹ️ KRANZAYY UC BOT\n\nНаш бот работает для вас ❤️‍🔥\n\nРесурсы:\n🛒 https://t.me/kranzayyuc\n📢 https://t.me/KRANZAYY_STORE\n⭐ Отзывы - https://t.me/Kranzayy_OTZ\n\n🆘 Поддержка: @M_K_B_59"
                edit_message(chat_id, message_id, text, main_menu())
                return
            
            answer_callback(cb_id, "❌ Неизвестно")
    
    except Exception as e:
        print(f"❌ ОШИБКА: {e}")

# ========== ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ==========

def get_username(chat_id):
    try:
        result = requests.post(f"{BASE_URL}/getChat", json={"chat_id": chat_id}).json()
        if result.get("ok"):
            user = result.get("result", {})
            username = user.get("username")
            if username:
                return username
            return user.get("first_name", "Пользователь")
        return "Пользователь"
    except:
        return "Пользователь"

# ========== ЦЕНЫ ==========

UC_PRICES = {
    "60": 75,
    "325": 390,
    "660": 760,
    "1800": 1990,
    "3850": 4000,
    "8100": 8630
}

POP_PRICES = {
    "10000": 176,
    "20000": 307,
    "30000": 439,
    "50000": 715,
    "100000": 1375
}

# ========== ЗАПУСК ==========

def main():
    offset = None
    print("🚀 БОТ ЗАПУЩЕН!")
    print("✅ КНОПКИ РАБОТАЮТ!")
    
    while True:
        try:
            response = requests.get(
                f"{BASE_URL}/getUpdates",
                params={"timeout": 30, "offset": offset}
            ).json()
            
            if response.get("ok"):
                for update in response.get("result", []):
                    handle_update(update)
                    offset = update["update_id"] + 1
            
            time.sleep(0.5)
        except Exception as e:
            print(f"❌ Ошибка: {e}")
            time.sleep(5)

if __name__ == "__main__":
    main()
