# ========== ЦЕНЫ ==========
UC_PRICES = {
    "60": 75,
    "325": 390,
    "660": 760,
    "1800": 1990,
    "3850": 4000,
    "8100": 8630
}

POPULARITY_PRICES = {
    "10000": 176,
    "20000": 307,
    "30000": 439,
    "40000": 578,
    "50000": 715,
    "60000": 857,
    "70000": 989,
    "100000": 1375,
    "150000": 1994,
    "200000": 2612,
    "500000": 6272
}

def get_cart_total(cart):
    total_uc = 0
    total_price = 0
    for k, v in cart.items():
        if k.startswith("pop_"):
            amount = k.replace("pop_", "")
            total_price += POPULARITY_PRICES.get(amount, 0) * v
            total_uc += int(amount) * v
        else:
            total_uc += int(k) * v
            total_price += UC_PRICES.get(k, 0) * v
    return total_uc, total_price

def get_cart_text(cart):
    text = ""
    for k, v in cart.items():
        if k.startswith("pop_"):
            amount = k.replace("pop_", "")
            formatted = f"{int(amount):,}".replace(",", " ")
            price = POPULARITY_PRICES.get(amount, 0)
            text += f"• {formatted} ПП x {v} = {price * v}₽\n"
        else:
            price = UC_PRICES.get(k, 0)
            text += f"• {k} UC x {v} = {price * v}₽\n"
    return text

# ========== ОБРАБОТКА ==========

def handle_update(update):
    try:
        if "message" in update:
            msg = update["message"]
            chat_id = msg["chat"]["id"]
            text = msg.get("text", "")
            user_id = str(chat_id)
            
            if user_id not in user_data:
                user_data[user_id] = {"cart": {}, "step": "main", "temp": {}}
            
            logger.info(f"💬 Сообщение от {chat_id}: {text}")
            
            if text == "/start":
                try:
                    result = send_photo(
                        chat_id,
                        PHOTO_URL,
                        caption=(
                            f'<tg-emoji emoji-id="{EMOJI_WAVE}">👋</tg-emoji> '
                            f'Добро пожаловать в KRANZAYY UC BOT!\n\n'
                            f'Выберите действие:'
                        ),
                        reply_markup=main_menu()
                    )
                    if not result.get("ok"):
                        send_message(
                            chat_id,
                            f'<tg-emoji emoji-id="{EMOJI_WAVE}">👋</tg-emoji> '
                            f'Добро пожаловать в KRANZAYY UC BOT!\n\n'
                            f'Выберите действие:',
                            main_menu()
                        )
                except:
                    send_message(
                        chat_id,
                        f'<tg-emoji emoji-id="{EMOJI_WAVE}">👋</tg-emoji> '
                        f'Добро пожаловать в KRANZAYY UC BOT!\n\n'
                        f'Выберите действие:',
                        main_menu()
                    )
                return
            
            # Обработка ввода PUBG ID
            if user_data[user_id].get("step") == "waiting_pubg_id":
                pubg_id = text.strip()
                if not pubg_id.isdigit() or len(pubg_id) < 5:
                    send_message(
                        chat_id,
                        f'<tg-emoji emoji-id="{EMOJI_CROSS}">❌</tg-emoji> '
                        f'Неверный формат. Введите только цифры (минимум 5):',
                        after_payment_menu()
                    )
                    return
                
                user_data[user_id]["temp"]["pubg_id"] = pubg_id
                user_data[user_id]["step"] = "main"
                
                cart = user_data[user_id]["cart"]
                total_uc, total_price = get_cart_total(cart)
                username = get_user_name(chat_id)
                user_mention = f'<a href="tg://user?id={chat_id}">{username}</a>'
                cart_text = get_cart_text(cart)
                
                owner_text = (
                    f'<tg-emoji emoji-id="{EMOJI_ORDER}">📦</tg-emoji> '
                    f'<b>НОВЫЙ ЗАКАЗ</b>\n\n'
                    f'<tg-emoji emoji-id="{EMOJI_USER}">👤</tg-emoji> Покупатель: {user_mention}\n'
                    f'<tg-emoji emoji-id="{EMOJI_UC}">🆔</tg-emoji> PUBG ID: {pubg_id}\n'
                    f'<tg-emoji emoji-id="{EMOJI_ORDER}">📦</tg-emoji> Товары:\n{cart_text}\n'
                    f'<tg-emoji emoji-id="{EMOJI_MONEY}">💰</tg-emoji> Итого: {total_price}₽\n\n'
                    f'<tg-emoji emoji-id="{EMOJI_TIME}">⏳</tg-emoji> Ожидает выполнения'
                )
                
                send_message(OWNER_ID, owner_text, owner_done_menu(f"{chat_id}_{int(time.time())}"), parse_mode="HTML")
                
                user_data[user_id]["cart"] = {}
                
                send_message(
                    chat_id,
                    f'<tg-emoji emoji-id="{EMOJI_CHECK}">✅</tg-emoji> '
                    f'<b>Заказ подтверждён!</b>\n\n'
                    f'<tg-emoji emoji-id="{EMOJI_UC}">🆔</tg-emoji> Ваш PUBG ID: {pubg_id}\n'
                    f'<tg-emoji emoji-id="{EMOJI_TIME}">⏳</tg-emoji> Время доставки: от 5 до 30 минут\n\n'
                    f'Ожидайте выполнения заказа.',
                    main_menu()
                )
                return
        
        elif "callback_query" in update:
            cb = update["callback_query"]
            chat_id = cb["message"]["chat"]["id"]
            message_id = cb["message"]["message_id"]
            data = cb["data"]
            cb_id = cb["id"]
            user_id = str(chat_id)
            
            if user_id not in user_data:
                user_data[user_id] = {"cart": {}, "step": "main", "temp": {}}
            
            logger.info(f"🖱 Нажата кнопка: {data}")
            
            # ---- НАЗАД ----
            if data == "back_to_main":
                edit_message(
                    chat_id,
                    message_id,
                    f'<tg-emoji emoji-id="{EMOJI_WAVE}">👋</tg-emoji> Главное меню:',
                    main_menu()
                )
                answer_callback(cb_id)
                return
            
            # ---- UC ----
            if data == "buy_uc":
                edit_message(
                    chat_id,
                    message_id,
                    f'<tg-emoji emoji-id="{EMOJI_CART}">🛒</tg-emoji> Выберите количество UC:',
                    cart_menu()
                )
                answer_callback(cb_id)
                return
            
            if data.startswith("add_"):
                amount = data.split("_")[1]
                user_data[user_id]["cart"][amount] = user_data[user_id]["cart"].get(amount, 0) + 1
                total_uc, total_price = get_cart_total(user_data[user_id]["cart"])
                answer_callback(cb_id, f'<tg-emoji emoji-id="{EMOJI_CHECK}">✅</tg-emoji> +{amount} UC! Итого: {total_price}₽')
                
                cart = user_data[user_id]["cart"]
                text = f'<tg-emoji emoji-id="{EMOJI_CART}">🛒</tg-emoji> Корзина:\n\n'
                if cart:
                    text += get_cart_text(cart)
                    text += f'\n<tg-emoji emoji-id="{EMOJI_ORDER}">📦</tg-emoji> Итого: {total_uc} UC — {total_price}₽'
                else:
                    text += "Пусто"
                edit_message(chat_id, message_id, text, cart_menu())
                return
            
            if data == "clear_cart":
                user_data[user_id]["cart"] = {}
                answer_callback(cb_id, f'<tg-emoji emoji-id="{EMOJI_CROSS}">🗑</tg-emoji> Корзина очищена!')
                edit_message(
                    chat_id,
                    message_id,
                    f'<tg-emoji emoji-id="{EMOJI_CART}">🛒</tg-emoji> Корзина пуста',
                    cart_menu()
                )
                return
            
            if data == "checkout":
                cart = user_data[user_id]["cart"]
                if not cart:
                    answer_callback(cb_id, f'<tg-emoji emoji-id="{EMOJI_CROSS}">❌</tg-emoji> Корзина пуста!', True)
                    return
                
                total_uc, total_price = get_cart_total(cart)
                cart_text = get_cart_text(cart)
                
                payment_text = (
                    f'<tg-emoji emoji-id="{EMOJI_CARD}">💳</tg-emoji> <b>Оплата заказа</b>\n\n'
                    f'<tg-emoji emoji-id="{EMOJI_ORDER}">📦</tg-emoji> Товары:\n{cart_text}\n'
                    f'<tg-emoji emoji-id="{EMOJI_MONEY}">💰</tg-emoji> Итого: {total_price}₽\n\n'
                    f'<b>Способы оплаты:</b>\n\n'
                    f'<tg-emoji emoji-id="{EMOJI_CARD}">💳</tg-emoji> <b>По номеру карты (Сбербанк):</b>\n'
                    f'<code>2202208555983213</code>\n\n'
                    f'<tg-emoji emoji-id="{EMOJI_PHONE}">📱</tg-emoji> <b>По номеру телефона (Сбербанк):</b>\n'
                    f'<code>+7 952 321-66-09</code>\n\n'
                    f'Оплатите заказ удобным для вас способом.\n'
                    f'Затем нажмите кнопку <b>«Я оплатил»</b>.'
                )
                
                edit_message(chat_id, message_id, payment_text, payment_menu(), parse_mode="HTML")
                answer_callback(cb_id)
                return
            
            # ---- ОПЛАТА ----
            if data == "i_paid":
                cart = user_data[user_id]["cart"]
                total_uc, total_price = get_cart_total(cart)
                username = get_user_name(chat_id)
                user_mention = f'<a href="tg://user?id={chat_id}">{username}</a>'
                cart_text = get_cart_text(cart)
                
                order_id = f"{chat_id}_{int(time.time())}"
                orders[order_id] = {
                    "user_id": chat_id,
                    "cart": cart,
                    "total_uc": total_uc,
                    "total_price": total_price,
                    "username": username,
                    "status": "waiting_confirmation"
                }
                
                owner_text = (
                    f'<tg-emoji emoji-id="{EMOJI_MONEY}">💰</tg-emoji> <b>ПОДТВЕРЖДЕНИЕ ОПЛАТЫ</b>\n\n'
                    f'<tg-emoji emoji-id="{EMOJI_USER}">👤</tg-emoji> Покупатель: {user_mention}\n'
                    f'<tg-emoji emoji-id="{EMOJI_ORDER}">📦</tg-emoji> Товары:\n{cart_text}\n'
                    f'<tg-emoji emoji-id="{EMOJI_MONEY}">💰</tg-emoji> Итого: {total_price}₽\n\n'
                    f'<tg-emoji emoji-id="{EMOJI_WARN}">❓</tg-emoji> Деньги пришли?'
                )
                
                send_message(OWNER_ID, owner_text, owner_confirm_menu(order_id), parse_mode="HTML")
                
                answer_callback(cb_id, f'<tg-emoji emoji-id="{EMOJI_CHECK}">✅</tg-emoji> Запрос на подтверждение отправлен!')
                edit_message(
                    chat_id,
                    message_id,
                    f'<tg-emoji emoji-id="{EMOJI_TIME}">⏳</tg-emoji> Ожидайте подтверждения оплаты...',
                    main_menu()
                )
                return
            
            if data == "cancel_payment":
                user_data[user_id]["cart"] = {}
                user_data[user_id]["step"] = "main"
                user_data[user_id]["temp"] = {}
                answer_callback(cb_id, f'<tg-emoji emoji-id="{EMOJI_CROSS}">❌</tg-emoji> Заказ отменён')
                edit_message(
                    chat_id,
                    message_id,
                    f'<tg-emoji emoji-id="{EMOJI_CROSS}">❌</tg-emoji> Заказ отменён',
                    main_menu()
                )
                return
            
            # ---- ПОДТВЕРЖДЕНИЕ ОТ ВЛАДЕЛЬЦА ----
            if data.startswith("confirm_payment_"):
                order_id = data.replace("confirm_payment_", "")
                order = orders.get(order_id)
                if not order:
                    answer_callback(cb_id, f'<tg-emoji emoji-id="{EMOJI_CROSS}">❌</tg-emoji> Заказ не найден')
                    return
                
                user_id = order["user_id"]
                username = order["username"]
                total_price = order["total_price"]
                total_uc = order["total_uc"]
                cart = order["cart"]
                
                send_message(
                    user_id,
                    f'<tg-emoji emoji-id="{EMOJI_CHECK}">✅</tg-emoji> <b>Оплата подтверждена!</b>\n\n'
                    f'<tg-emoji emoji-id="{EMOJI_ORDER}">📦</tg-emoji> Товар: {total_uc} UC\n'
                    f'<tg-emoji emoji-id="{EMOJI_MONEY}">💰</tg-emoji> Сумма: {total_price}₽\n\n'
                    f'<tg-emoji emoji-id="{EMOJI_UC}">🆔</tg-emoji> <b>Введите ваш PUBG ID:</b>\n'
                    f'<tg-emoji emoji-id="{EMOJI_WARN}">⚠️</tg-emoji> <i>Указывайте ID осторожно!\n'
                    f'Если вы укажете неверный ID, ваш товар будет отправлен другому человеку.</i>',
                    after_payment_menu(),
                    parse_mode="HTML"
                )
                
                user_data[str(user_id)]["step"] = "waiting_pubg_id"
                user_data[str(user_id)]["temp"]["order_id"] = order_id
                
                answer_callback(cb_id, f'<tg-emoji emoji-id="{EMOJI_CHECK}">✅</tg-emoji> Пользователь уведомлён')
                edit_message(
                    chat_id,
                    message_id,
                    f'<tg-emoji emoji-id="{EMOJI_CHECK}">✅</tg-emoji> Пользователь уведомлён. Ожидает ввода PUBG ID',
                    main_menu()
                )
                return
            
            if data.startswith("reject_payment_"):
                order_id = data.replace("reject_payment_", "")
                order = orders.get(order_id)
                if not order:
                    answer_callback(cb_id, f'<tg-emoji emoji-id="{EMOJI_CROSS}">❌</tg-emoji> Заказ не найден')
                    return
                
                user_id = order["user_id"]
                
                send_message(
                    user_id,
                    f'<tg-emoji emoji-id="{EMOJI_CROSS}">❌</tg-emoji> <b>Оплата не подтверждена</b>\n\n'
                    f'К сожалению, мы не получили ваш платёж.\n'
                    f'Заказ отменён.',
                    main_menu(),
                    parse_mode="HTML"
                )
                
                user_data[str(user_id)]["cart"] = {}
                user_data[str(user_id)]["step"] = "main"
                user_data[str(user_id)]["temp"] = {}
                
                answer_callback(cb_id, f'<tg-emoji emoji-id="{EMOJI_CROSS}">❌</tg-emoji> Заказ отменён')
                edit_message(
                    chat_id,
                    message_id,
                    f'<tg-emoji emoji-id="{EMOJI_CROSS}">❌</tg-emoji> Заказ отменён',
                    main_menu()
                )
                return
            
            # ---- ВЫПОЛНЕНИЕ ЗАКАЗА ВЛАДЕЛЬЦЕМ ----
            if data.startswith("order_done_"):
                order_id = data.replace("order_done_", "")
                order = orders.get(order_id)
                if not order:
                    answer_callback(cb_id, f'<tg-emoji emoji-id="{EMOJI_CROSS}">❌</tg-emoji> Заказ не найден')
                    return
                
                user_id = order["user_id"]
                total_uc = order["total_uc"]
                pubg_id = user_data[str(user_id)].get("temp", {}).get("pubg_id", "Не указан")
                
                send_message(
                    user_id,
                    f'<tg-emoji emoji-id="{EMOJI_DONE}">🎉</tg-emoji> <b>Ваш заказ выполнен!</b>\n\n'
                    f'<tg-emoji emoji-id="{EMOJI_ORDER}">📦</tg-emoji> Товар: {total_uc} UC\n'
                    f'<tg-emoji emoji-id="{EMOJI_UC}">🆔</tg-emoji> PUBG ID: {pubg_id}\n\n'
                    f'<tg-emoji emoji-id="{EMOJI_HEART}">❤️‍🔥</tg-emoji> Спасибо за покупку!\n'
                    f'Мы ценим ваше доверие.',
                    main_menu(),
                    parse_mode="HTML"
                )
                
                answer_callback(cb_id, f'<tg-emoji emoji-id="{EMOJI_CHECK}">✅</tg-emoji> Заказ выполнен!')
                edit_message(
                    chat_id,
                    message_id,
                    f'<tg-emoji emoji-id="{EMOJI_CHECK}">✅</tg-emoji> Заказ {order_id} выполнен!',
                    main_menu()
                )
                
                user_data[str(user_id)]["cart"] = {}
                user_data[str(user_id)]["step"] = "main"
                user_data[str(user_id)]["temp"] = {}
                return
            
            # ---- ПОПУЛЯРНОСТЬ (ДОБАВЛЯЕМ В КОРЗИНУ) ----
            if data == "popularity":
                edit_message(
                    chat_id,
                    message_id,
                    f'<tg-emoji emoji-id="{EMOJI_STAR}">⭐️</tg-emoji> Выберите количество популярности:',
                    popularity_menu()
                )
                answer_callback(cb_id)
                return
            
            if data.startswith("pop_"):
                amount = data.split("_")[1]
                formatted = f"{int(amount):,}".replace(",", " ")
                price = POPULARITY_PRICES.get(amount, 0)
                
                # Добавляем популярность в корзину
                user_data[user_id]["cart"][f"pop_{amount}"] = user_data[user_id]["cart"].get(f"pop_{amount}", 0) + 1
                total_uc, total_price = get_cart_total(user_data[user_id]["cart"])
                
                answer_callback(cb_id, f'<tg-emoji emoji-id="{EMOJI_CHECK}">✅</tg-emoji> Выбрано {formatted} ПП! Добавлено в корзину.')
                
                # Показываем обновлённую корзину
                cart = user_data[user_id]["cart"]
                text = f'<tg-emoji emoji-id="{EMOJI_CART}">🛒</tg-emoji> Корзина:\n\n'
                if cart:
                    text += get_cart_text(cart)
                    text += f'\n<tg-emoji emoji-id="{EMOJI_ORDER}">📦</tg-emoji> Итого: {total_uc} UC — {total_price}₽'
                else:
                    text += "Пусто"
                edit_message(chat_id, message_id, text, cart_menu())
                return
            
            # ---- ИНФОРМАЦИЯ ----
            if data == "info":
                text = (
                    f'<tg-emoji emoji-id="{EMOJI_INFO}">ℹ️</tg-emoji> KRANZAYY UC BOT\n\n'
                    f'Наш бот работает для вас '
                    f'<tg-emoji emoji-id="{EMOJI_HEART}">❤️‍🔥</tg-emoji>\n\n'
                    f'<tg-emoji emoji-id="{EMOJI_FIRE}">🌟</tg-emoji>'
                    f'<tg-emoji emoji-id="{EMOJI_SPARKLE}">✨</tg-emoji>'
                    f'<tg-emoji emoji-id="{EMOJI_SPARKLE}">✨</tg-emoji>'
                    f'<tg-emoji emoji-id="{EMOJI_STAR2}">💫</tg-emoji>\n\n'
                    f'Наши ресурсы:\n'
                    f'<tg-emoji emoji-id="{EMOJI_SHOP}">🛒</tg-emoji> Магазин - https://t.me/kranzayyuc\n'
                    f'<tg-emoji emoji-id="{EMOJI_MEGAPHONE}">📢</tg-emoji> Канал - https://t.me/KRANZAYY_STORE\n'
                    f'<tg-emoji emoji-id="{EMOJI_METRO}">🏪</tg-emoji> Метро шоп - https://t.me/MetroShop_Kranzayy\n'
                    f'<tg-emoji emoji-id="{EMOJI_REVIEW}">⭐</tg-emoji> Отзывы - https://t.me/Kranzayy_OTZ\n\n'
                    f'<tg-emoji emoji-id="{EMOJI_DIAMOND}">💎</tg-emoji>'
                    f'<tg-emoji emoji-id="{EMOJI_DIAMOND}">💎</tg-emoji>'
                    f'<tg-emoji emoji-id="{EMOJI_DIAMOND}">💎</tg-emoji>'
                    f'<tg-emoji emoji-id="{EMOJI_DIAMOND}">💎</tg-emoji>\n\n'
                    f'<tg-emoji emoji-id="{EMOJI_SUPPORT}">🆘</tg-emoji> Техническая поддержка: @M_K_B_59'
                )
                edit_message(chat_id, message_id, text, main_menu(), parse_mode="HTML")
                answer_callback(cb_id)
                return
            
            # ---- НЕИЗВЕСТНО ----
            logger.warning(f"⚠️ Неизвестная кнопка: {data}")
            answer_callback(cb_id, f'<tg-emoji emoji-id="{EMOJI_CROSS}">❌</tg-emoji> Неизвестная команда')
    
    except Exception as e:
        logger.error(f"💥 ОШИБКА: {e}")
        logger.error(traceback.format_exc())

# ========== ЗАПУСК ==========

def main():
    offset = None
    logger.info("=" * 50)
    logger.info("🚀 БОТ ЗАПУЩЕН (ТОЛЬКО ПРЕМИУМ-ЭМОДЗИ)")
    logger.info(f"👤 Владелец: {OWNER_ID}")
    logger.info("💎 Все эмодзи заменены на премиум-версии")
    logger.info("🏦 Сбербанк указан в реквизитах")
    logger.info("⭐️ Популярность добавляется в корзину и проходит оплату")
    logger.info("=" * 50)
    
    while True:
        try:
            response = requests.get(
                f"{BASE_URL}/getUpdates",
                params={"timeout": 30, "offset": offset},
                timeout=35
            ).json()
            
            if response.get("ok"):
                for update in response.get("result", []):
                    handle_update(update)
                    offset = update["update_id"] + 1
            else:
                logger.error(f"❌ Ошибка: {response}")
            
            time.sleep(0.5)
        except Exception as e:
            logger.error(f"💥 Ошибка: {e}")
            time.sleep(10)

if __name__ == "__main__":
    main()
