            pass

# ========== ЗАПУСК БОТА ==========

def main():
    offset = None
    logger.info("=" * 60)
    logger.info("🚀 БОТ KRANZAYY UC BOT ЗАПУЩЕН")
    logger.info(f"👤 Владелец: {OWNER_ID}")
    logger.info("💎 Используются только премиум-эмодзи")
    logger.info("📸 Фото загружается из: " + PHOTO_URL)
    logger.info("=" * 60)
    
    while True:
        try:
            response = requests.get(
                f"{BASE_URL}/getUpdates",
                params={"timeout": 30, "offset": offset},
                timeout=35
            ).json()
            
            if response.get("ok"):
                for update in response.get("result", []):
                    handle_update(update)
                    offset = update["update_id"] + 1
            else:
                logger.error(f"❌ Ошибка getUpdates: {response}")
            
            time.sleep(0.5)
        
        except requests.exceptions.Timeout:
            logger.warning("⏰ Таймаут getUpdates, переподключение...")
            time.sleep(2)
        except requests.exceptions.ConnectionError:
            logger.error("🔌 Ошибка подключения к Telegram API")
            time.sleep(10)
        except KeyboardInterrupt:
            logger.info("⏹ Бот остановлен пользователем")
            break
        except Exception as e:
            logger.error(f"💥 КРИТИЧЕСКАЯ ОШИБКА В MAIN: {e}")
            logger.error(traceback.format_exc())
            time.sleep(10)

if __name__ == "__main__":
    main()
