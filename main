# ========== ОБРАБОТЧИК ОБНОВЛЕНИЙ ==========

def handle_update(update):
    try:
        # ---- ОБРАБОТКА СООБЩЕНИЙ ----
        if "message" in update:
            msg = update["message"]
            chat_id = msg["chat"]["id"]
            text = msg.get("text", "")
            user_id = str(chat_id)
            
            # Инициализация пользователя
            if user_id not in user_data:
                user_data[user_id] = {"cart": {}, "step": "main", "temp": {}}
            
            logger.info(f"💬 Сообщение от {user_id}: {text[:50]}")
            
            # ---- КОМАНДА /start ----
            if text == "/start":
                try:
                    result = send_photo(
                        chat_id,
                        PHOTO_URL,
                        caption=(
                            f'<tg-emoji emoji-id="{E_WELCOME}">👋</tg-emoji> '
                            f'<b>Добро пожаловать в KRANZAYY UC BOT!</b>\n\n'
                            f'<tg-emoji emoji-id="{E_GEAR}">⚙️</tg-emoji> Мы предлагаем:\n'
                            f'<tg-emoji emoji-id="{E_UC}">💵</tg-emoji> Пополнение UC\n'
                            f'<tg-emoji emoji-id="{E_STAR}">⭐️</tg-emoji> Накрутка популярности\n\n'
                            f'<tg-emoji emoji-id="{E_TIME}">⏳</tg-emoji> Работаем 24/7\n'
                            f'<tg-emoji emoji-id="{E_SUPPORT}">🆘</tg-emoji> Поддержка: @M_K_B_59'
                        ),
                        reply_markup=main_menu()
                    )
                    if not result.get("ok"):
                        send_message(
                            chat_id,
                            f'<tg-emoji emoji-id="{E_WELCOME}">👋</tg-emoji> '
                            f'Добро пожаловать в KRANZAYY UC BOT!\n\nВыберите действие:',
                            main_menu()
                        )
                except Exception as e:
                    logger.error(f"Ошибка отправки фото: {e}")
                    send_message(
                        chat_id,
                        f'<tg-emoji emoji-id="{E_WELCOME}">👋</tg-emoji> '
                        f'Добро пожаловать в KRANZAYY UC BOT!\n\nВыберите действие:',
                        main_menu()
                    )
                return
            
            # ---- ВВОД PUBG ID ПОСЛЕ ОПЛАТЫ ----
            if user_data[user_id].get("step") == "waiting_pubg_id":
                pubg_id = text.strip()
                if not pubg_id.isdigit() or len(pubg_id) < 5:
                    send_message(
                        chat_id,
                        f'<tg-emoji emoji-id="{E_CROSS}">❌</tg-emoji> '
                        f'Неверный формат PUBG ID.\n\n'
                        f'<tg-emoji emoji-id="{E_PIN}">🆔</tg-emoji> '
                        f'Введите только цифры (минимум 5 цифр):',
                        after_payment_menu()
                    )
                    return
                
                # Сохраняем PUBG ID
                user_data[user_id]["temp"]["pubg_id"] = pubg_id
                user_data[user_id]["step"] = "main"
                
                # Получаем данные заказа
                cart = user_data[user_id]["cart"]
                total_uc, total_price = get_cart_total(cart)
                username = get_user_name(chat_id)
                
                # Формируем текст корзины для владельца
                cart_text = ""
                for key, count in cart.items():
                    if key.startswith("pop_"):
                        amount = key.replace("pop_", "")
                        price = POPULARITY_PRICES.get(amount, 0)
                        cart_text += f"• {amount} ПП x {count} = {price * count}₽\n"
                    else:
                        price = UC_PRICES.get(key, 0)
                        cart_text += f"• {key} UC x {count} = {price * count}₽\n"
                
                # Отправляем уведомление владельцу
                order_id = f"{chat_id}_{int(time.time())}"
                owner_text = (
                    f'<tg-emoji emoji-id="{E_ORDER}">📦</tg-emoji> <b>НОВЫЙ ЗАКАЗ</b>\n\n'
                    f'<tg-emoji emoji-id="{E_STAR}">👤</tg-emoji> Покупатель: {username}\n'
                    f'<tg-emoji emoji-id="{E_PIN}">🆔</tg-emoji> PUBG ID: {pubg_id}\n'
                    f'<tg-emoji emoji-id="{E_CART}">📦</tg-emoji> Товары:\n{cart_text}\n'
                    f'<tg-emoji emoji-id="{E_MONEY}">💰</tg-emoji> Итого: {total_price}₽\n\n'
                    f'<tg-emoji emoji-id="{E_TIME}">⏳</tg-emoji> Статус: Ожидает выполнения'
                )
                
                send_message(OWNER_ID, owner_text, owner_done_menu(order_id), parse_mode="HTML")
                
                # Сохраняем заказ
                orders[order_id] = {
                    "user_id": chat_id,
                    "cart": cart.copy(),
                    "total_uc": total_uc,
                    "total_price": total_price,
                    "username": username,
                    "pubg_id": pubg_id,
                    "status": "waiting_delivery"
                }
                
                # Очищаем корзину
                user_data[user_id]["cart"] = {}
                
                send_message(
                    chat_id,
                    f'<tg-emoji emoji-id="{E_CHECK}">✅</tg-emoji> <b>Заказ подтверждён!</b>\n\n'
                    f'<tg-emoji emoji-id="{E_PIN}">🆔</tg-emoji> Ваш PUBG ID: <code>{pubg_id}</code>\n'
                    f'<tg-emoji emoji-id="{E_TIME}">⏳</tg-emoji> Время доставки: от 5 до 30 минут\n\n'
                    f'<tg-emoji emoji-id="{E_SUPPORT}">🆘</tg-emoji> По вопросам: @M_K_B_59',
                    main_menu(),
                    parse_mode="HTML"
                )
                return
        
        # ---- ОБРАБОТКА КНОПОК ----
        elif "callback_query" in update:
            cb = update["callback_query"]
            chat_id = cb["message"]["chat"]["id"]
            data = cb["data"]
            cb_id = cb["id"]
            user_id = str(chat_id)
            
            # Инициализация пользователя
            if user_id not in user_data:
                user_data[user_id] = {"cart": {}, "step": "main", "temp": {}}
            
            logger.info(f"🖱 Нажата кнопка: {data} от {user_id}")
            
            # ---- ОТВЕЧАЕМ НА КНОПКУ (ОБЯЗАТЕЛЬНО) ----
            answer_callback(cb_id)
            
            # ---- НАЗАД В ГЛАВНОЕ МЕНЮ ----
            if data == "back_to_main":
                send_message(
                    chat_id,
                    f'<tg-emoji emoji-id="{E_WELCOME}">👋</tg-emoji> Главное меню:',
                    main_menu()
                )
                return
            
            # ---- КУПИТЬ UC (ОТКРЫТЬ КОРЗИНУ) ----
            if data == "buy_uc":
                cart_text = format_cart_text(user_data[user_id]["cart"])
                send_message(chat_id, cart_text, cart_menu())
                return
            
            # ---- ДОБАВЛЕНИЕ В КОРЗИНУ ----
            if data.startswith("add_"):
                amount = data.split("_")[1]
                user_data[user_id]["cart"][amount] = user_data[user_id]["cart"].get(amount, 0) + 1
                
                total_uc, total_price = get_cart_total(user_data[user_id]["cart"])
