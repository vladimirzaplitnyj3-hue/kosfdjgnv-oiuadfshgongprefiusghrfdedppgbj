# ========== ФУНКЦИЯ ЗАПРОСОВ К API ==========
def api_request(method, payload):
    """Универсальная функция для отправки запросов к Telegram API с логированием"""
    url = f"{BASE_URL}/{method}"
    logger.debug(f"📤 Запрос {method} к API")
    try:
        response = requests.post(url, json=payload, timeout=30)
        result = response.json()
        if result.get("ok"):
            logger.debug(f"✅ {method} успешно выполнен")
        else:
            error_desc = result.get('description', 'Неизвестная ошибка')
            logger.error(f"❌ Ошибка {method}: {error_desc}")
        return result
    except requests.exceptions.Timeout:
        logger.error(f"⏰ Таймаут при выполнении {method}")
        return {"ok": False, "error": "timeout"}
    except requests.exceptions.ConnectionError:
        logger.error(f"🔌 Ошибка подключения при {method}")
        return {"ok": False, "error": "connection"}
    except Exception as e:
        logger.error(f"💥 Критическая ошибка в {method}: {e}")
        logger.error(traceback.format_exc())
        return {"ok": False, "error": str(e)}

# ========== ОСНОВНЫЕ ФУНКЦИИ БОТА ==========
def send_message(chat_id, text, reply_markup=None, parse_mode="HTML"):
    """Отправка текстового сообщения"""
    payload = {"chat_id": chat_id, "text": text, "parse_mode": parse_mode}
    if reply_markup:
        payload["reply_markup"] = json.dumps(reply_markup)
    return api_request("sendMessage", payload)

def send_photo(chat_id, photo, caption=None, reply_markup=None, parse_mode="HTML"):
    """Отправка фото по URL"""
    payload = {"chat_id": chat_id, "photo": photo, "parse_mode": parse_mode}
    if caption:
        payload["caption"] = caption
    if reply_markup:
        payload["reply_markup"] = json.dumps(reply_markup)
    return api_request("sendPhoto", payload)

def answer_callback(callback_id, text=None, show_alert=False):
    """Ответ на нажатие кнопки"""
    payload = {"callback_query_id": callback_id}
    if text:
        payload["text"] = text
    if show_alert:
        payload["show_alert"] = True
    return api_request("answerCallbackQuery", payload)

def get_user_name(chat_id):
    """Получение имени пользователя по его ID"""
    try:
        result = api_request("getChat", {"chat_id": chat_id})
        if result.get("ok"):
            user = result.get("result", {})
            username = user.get("username")
            if username:
                return f"@{username}"
            first_name = user.get("first_name", "Пользователь")
            return first_name
        return "Пользователь"
    except:
        return "Пользователь"

def get_cart_total(cart):
    """Подсчет итоговой суммы и количества UC в корзине"""
    total_uc = 0
    total_price = 0
    for key, count in cart.items():
        if key.startswith("pop_"):
            amount = key.replace("pop_", "")
            total_price += POPULARITY_PRICES.get(amount, 0) * count
        else:
            total_uc += int(key) * count
            total_price += UC_PRICES.get(key, 0) * count
    return total_uc, total_price

def format_cart_text(cart):
    """Форматирование текста корзины для отображения"""
    if not cart:
        return f'<tg-emoji emoji-id="{E_CART}">🛒</tg-emoji> Корзина пуста'
    
    text = f'<tg-emoji emoji-id="{E_CART}">🛒</tg-emoji> Ваша корзина:\n\n'
    for key, count in cart.items():
        if key.startswith("pop_"):
            amount = key.replace("pop_", "")
            price = POPULARITY_PRICES.get(amount, 0)
            text += f"<tg-emoji emoji-id=\"{E_STAR}\">⭐️</tg-emoji> {amount} ПП x {count} = {price * count}₽\n"
        else:
            price = UC_PRICES.get(key, 0)
            text += f"<tg-emoji emoji-id=\"{E_UC}\">💵</tg-emoji> {key} UC x {count} = {price * count}₽\n"
    
    total_uc, total_price = get_cart_total(cart)
    text += f'\n<tg-emoji emoji-id="{E_MONEY}">💰</tg-emoji> Итого: {total_uc} UC — {total_price}₽'
    return text

