# ========== ОБРАБОТКА ==========

def handle_update(update):
    try:
        # Обработка сообщений
        if "message" in update:
            msg = update["message"]
            chat_id = msg["chat"]["id"]
            text = msg.get("text", "")
            
            if text == "/start":
                send_message(chat_id, "👋 Добро пожаловать в KRANZAYY UC BOT!\n\nВыберите действие:", get_main_menu())
            return
        
        # Обработка кнопок
        elif "callback_query" in update:
            cb = update["callback_query"]
            chat_id = cb["message"]["chat"]["id"]
            message_id = cb["message"]["message_id"]
            data = cb["data"]
            cb_id = cb["id"]
            
            print(f"🔔 Нажата кнопка: {data}")  # Лог для отладки
            
            # ===== НАЗАД =====
            if data == "back_to_main":
                edit_message(chat_id, message_id, "👋 Главное меню:", get_main_menu())
                answer_callback(cb_id)
                return
            
            # ===== UC =====
            if data == "buy_uc":
                edit_message(chat_id, message_id, "🛒 Выберите количество UC:", get_cart_menu())
                answer_callback(cb_id)
                return
            
            if data.startswith("add_"):
                amount = data.split("_")[1]
                answer_callback(cb_id, f"✅ +{amount} UC!")
                edit_message(chat_id, message_id, f"✅ {amount} UC добавлено в корзину!", get_cart_menu())
                return
            
            if data == "clear_cart":
                answer_callback(cb_id, "🗑 Корзина очищена!")
                edit_message(chat_id, message_id, "🛒 Корзина пуста", get_cart_menu())
                return
            
            if data == "checkout":
                answer_callback(cb_id, "✅ Заказ оформлен!")
                send_message(chat_id, "✅ Заказ оформлен!\nОжидайте подтверждения оператора.")
                edit_message(chat_id, message_id, "🛒 Заказ оформлен", get_cart_menu())
                return
            
            # ===== ПОПУЛЯРНОСТЬ =====
            if data == "popularity":
                edit_message(chat_id, message_id, "⭐️ Выберите количество популярности:", get_popularity_menu())
                answer_callback(cb_id)
                return
            
            if data.startswith("pop_"):
                amount = data.split("_")[1]
                formatted = f"{int(amount):,}".replace(",", " ")
                answer_callback(cb_id, f"✅ Выбрано {formatted} ПП!")
                send_message(chat_id, f"✅ Вы выбрали {formatted} ПП\n\nОжидайте, оператор свяжется с вами!\n\n🆘 Поддержка: @M_K_B_59")
                edit_message(chat_id, message_id, f"✅ Выбрано {formatted} ПП", get_popularity_menu())
                return
            
            # ===== ИНФОРМАЦИЯ =====
            if data == "info":
                text = (
                    "ℹ️ KRANZAYY UC BOT\n\n"
                    "Наш бот работает для вас ❤️‍🔥\n\n"
                    "📌 Наши ресурсы:\n"
                    "🛒 Магазин - https://t.me/kranzayyuc\n"
                    "📢 Канал - https://t.me/KRANZAYY_STORE\n"
                    "⭐ Отзывы - https://t.me/Kranzayy_OTZ\n\n"
                    "🆘 Поддержка: @M_K_B_59"
                )
                edit_message(chat_id, message_id, text, get_main_menu())
                answer_callback(cb_id)
                return
            
            # ===== НЕИЗВЕСТНО =====
            answer_callback(cb_id, "❌ Неизвестная команда")
    
    except Exception as e:
        print(f"❌ ОШИБКА: {e}")

# ========== ЗАПУСК ==========

def main():
    offset = None
    print("🚀 БОТ ЗАПУЩЕН!")
    print("✅ Все кнопки должны работать!")
    
    while True:
        try:
            url = f"{BASE_URL}/getUpdates"
            params = {"timeout": 30, "offset": offset}
            response = requests.get(url, params=params).json()
            
            if response.get("ok"):
                for update in response.get("result", []):
                    handle_update(update)
                    offset = update["update_id"] + 1
            else:
                print(f"❌ Ошибка API: {response}")
            
            time.sleep(0.5)
        
        except Exception as e:
            print(f"❌ КРИТИЧЕСКАЯ ОШИБКА: {e}")
            time.sleep(5)

if __name__ == "__main__":
    main()
