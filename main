# ========== ЦЕНЫ ==========

UC_PRICES = {
    "60": 75,
    "325": 390,
    "660": 760,
    "1800": 1990,
    "3850": 4000,
    "8100": 8630
}

POP_PRICES = {
    "10000": 176,
    "20000": 307,
    "30000": 439,
    "40000": 578,
    "50000": 715,
    "60000": 857,
    "70000": 989,
    "100000": 1375,
    "150000": 1994,
    "200000": 2612,
    "500000": 6272
}

# ========== ОБРАБОТКА ==========

def handle_update(update):
    try:
        if "message" in update:
            msg = update["message"]
            chat_id = msg["chat"]["id"]
            text = msg.get("text", "")
            user_id = str(chat_id)
            
            if user_id not in user_data:
                user_data[user_id] = {"uc_cart": {}, "pop_cart": {}, "step": "main", "temp": {}}
            
            if text == "/start":
                try:
                    send_photo(
                        chat_id,
                        PHOTO_URL,
                        caption="👋 Добро пожаловать в KRANZAYY UC BOT!\n\nВыберите действие:",
                        reply_markup=main_menu()
                    )
                except:
                    send_message(chat_id, "👋 Добро пожаловать в KRANZAYY UC BOT!\n\nВыберите действие:", main_menu())
                return
            
            if user_data[user_id].get("step") == "waiting_pubg":
                pubg_id = text.strip()
                if not pubg_id.isdigit() or len(pubg_id) < 5:
                    send_message(chat_id, "❌ Неверный формат. Введите только цифры (минимум 5):", after_payment_menu())
                    return
                
                user_data[user_id]["temp"]["pubg_id"] = pubg_id
                user_data[user_id]["step"] = "main"
                
                order_type = user_data[user_id]["temp"].get("order_type", "UC")
                
                if order_type == "UC":
                    cart = user_data[user_id]["uc_cart"]
                    total = sum(int(k) * v for k, v in cart.items())
                    price = sum(UC_PRICES.get(k, 0) * v for k, v in cart.items())
                    cart_text = ""
                    for k, v in cart.items():
                        cart_text += f"• {k} UC x {v} = {UC_PRICES.get(k, 0) * v}₽\n"
                else:
                    cart = user_data[user_id]["pop_cart"]
                    total = sum(int(k) * v for k, v in cart.items())
                    price = sum(POP_PRICES.get(k, 0) * v for k, v in cart.items())
                    cart_text = ""
                    for k, v in cart.items():
                        formatted = f"{int(k):,}".replace(",", " ")
                        cart_text += f"• {formatted} ПП x {v} = {POP_PRICES.get(k, 0) * v}₽\n"
                
                order_id = f"{chat_id}_{int(time.time())}"
                orders[order_id] = {
                    "user_id": chat_id,
                    "total": total,
                    "price": price,
                    "order_type": order_type,
                    "pubg_id": pubg_id,
                    "username": get_username(chat_id)
                }
                
                username = get_username(chat_id)
                owner_text = f"📦 НОВЫЙ ЗАКАЗ ({order_type})\n\n👤 {username}\n🆔 PUBG: {pubg_id}\n📦 Товары:\n{cart_text}\n💰 Сумма: {price}₽"
                send_message(OWNER_ID, owner_text, done_menu(order_id))
                
                send_message(chat_id, f"✅ ЗАКАЗ ПОДТВЕРЖДЁН!\n\n📦 {total} {order_type}\n💰 {price}₽\n🆔 PUBG: {pubg_id}\n⏳ Доставка 5-30 минут", main_menu())
                
                if order_type == "UC":
                    user_data[user_id]["uc_cart"] = {}
                else:
                    user_data[user_id]["pop_cart"] = {}
                return
        
        elif "callback_query" in update:
            cb = update["callback_query"]
            chat_id = cb["message"]["chat"]["id"]
            message_id = cb["message"]["message_id"]
            data = cb["data"]
            cb_id = cb["id"]
            user_id = str(chat_id)
            
            print(f"🔔 Кнопка: {data}")
            answer_callback(cb_id, f"✅ {data}")
            
            if user_id not in user_data:
                user_data[user_id] = {"uc_cart": {}, "pop_cart": {}, "step": "main", "temp": {}}
            
            # ---- НАЗАД (С ФОТО) ----
            if data == "back":
                try:
                    send_photo(
                        chat_id,
                        PHOTO_URL,
                        caption="👋 Главное меню:",
                        reply_markup=main_menu()
                    )
                    delete_message(chat_id, message_id)
                except:
                    edit_message(chat_id, message_id, "👋 Главное меню:", main_menu())
                return
            
            # ---- UC ----
            if data == "buy_uc":
                edit_message(chat_id, message_id, "🛒 КОРЗИНА UC\n\nВыберите количество UC:", uc_menu())
                return
            
            if data.startswith("uc_") and data not in ["uc_checkout", "uc_clear"]:
                amount = data.replace("uc_", "")
                user_data[user_id]["uc_cart"][amount] = user_data[user_id]["uc_cart"].get(amount, 0) + 1
                total = sum(int(k) * v for k, v in user_data[user_id]["uc_cart"].items())
                price = sum(UC_PRICES.get(k, 0) * v for k, v in user_data[user_id]["uc_cart"].items())
                
                cart_text = ""
                for k, v in user_data[user_id]["uc_cart"].items():
                    cart_text += f"• {k} UC x {v} = {UC_PRICES.get(k, 0) * v}₽\n"
                
                edit_message(chat_id, message_id, f"🛒 КОРЗИНА UC\n\n{cart_text}\n📦 Итого: {total} UC — {price}₽", uc_menu())
                return
            
            if data == "uc_clear":
                user_data[user_id]["uc_cart"] = {}
                edit_message(chat_id, message_id, "🛒 КОРЗИНА UC\n\n🗑 Очищена", uc_menu())
                return
            
            if data == "uc_checkout":
                cart = user_data[user_id]["uc_cart"]
                if not cart:
                    answer_callback(cb_id, "❌ Корзина пуста!", True)
                    return
                
                user_data[user_id]["temp"]["order_type"] = "UC"
                total = sum(int(k) * v for k, v in cart.items())
                price = sum(UC_PRICES.get(k, 0) * v for k, v in cart.items())
                
                cart_text = ""
                for k, v in cart.items():
                    cart_text += f"• {k} UC x {v} = {UC_PRICES.get(k, 0) * v}₽\n"
                
                text = f"💳 ОПЛАТА ЗАКАЗА UC\n\n📦 Товары:\n{cart_text}\n💰 Итого: {price}₽\n\n🏦 Способы оплаты (Сбербанк):\n💳 Карта: 2202208555983213\n📱 Телефон: +7 952 321-66-09\n\nНажмите «Я оплатил» после перевода."
                edit_message(chat_id, message_id, text, payment_menu())
                return
            
            # ---- ПОПУЛЯРНОСТЬ ----
            if data == "popularity":
                edit_message(chat_id, message_id, "⭐️ КОРЗИНА ПОПУЛЯРНОСТИ\n\nВыберите количество ПП:", popularity_menu())
                return
            
            if data.startswith("pop_") and data not in ["pop_checkout", "pop_clear"]:
                amount = data.replace("pop_", "")
                user_data[user_id]["pop_cart"][amount] = user_data[user_id]["pop_cart"].get(amount, 0) + 1
                total = sum(int(k) * v for k, v in user_data[user_id]["pop_cart"].items())
                price = sum(POP_PRICES.get(k, 0) * v for k, v in user_data[user_id]["pop_cart"].items())
                
                cart_text = ""
                for k, v in user_data[user_id]["pop_cart"].items():
                    formatted = f"{int(k):,}".replace(",", " ")
                    cart_text += f"• {formatted} ПП x {v} = {POP_PRICES.get(k, 0) * v}₽\n"
                
                edit_message(chat_id, message_id, f"⭐️ КОРЗИНА ПОПУЛЯРНОСТИ\n\n{cart_text}\n📦 Итого: {total} ПП — {price}₽", popularity_menu())
                return
            
            if data == "pop_clear":
                user_data[user_id]["pop_cart"] = {}
                edit_message(chat_id, message_id, "⭐️ КОРЗИНА ПОПУЛЯРНОСТИ\n\n🗑 Очищена", popularity_menu())
                return
            
            if data == "pop_checkout":
                cart = user_data[user_id]["pop_cart"]
                if not cart:
                    answer_callback(cb_id, "❌ Корзина пуста!", True)
                    return
                
                user_data[user_id]["temp"]["order_type"] = "ПП"
                total = sum(int(k) * v for k, v in cart.items())
                price = sum(POP_PRICES.get(k, 0) * v for k, v in cart.items())
                
                cart_text = ""
                for k, v in cart.items():
                    formatted = f"{int(k):,}".replace(",", " ")
                    cart_text += f"• {formatted} ПП x {v} = {POP_PRICES.get(k, 0) * v}₽\n"
                
                text = f"💳 ОПЛАТА ЗАКАЗА ПОПУЛЯРНОСТИ\n\n📦 Товары:\n{cart_text}\n💰 Итого: {price}₽\n\n🏦 Способы оплаты (Сбербанк):\n💳 Карта: 2202208555983213\n📱 Телефон: +7 952 321-66-09\n\nНажмите «Я оплатил» после перевода."
                edit_message(chat_id, message_id, text, payment_menu())
