# ========== ФУНКЦИЯ ЗАПРОСОВ С ЛОГИРОВАНИЕМ ==========
def api_request(method, payload):
    """Универсальная функция для запросов к API"""
    url = f"{BASE_URL}/{method}"
    
    # Логируем запрос (без полного payload для безопасности)
    log_payload = {k: v for k, v in payload.items() if k not in ['text', 'caption']}
    if 'text' in payload:
        log_payload['text'] = payload['text'][:100] + '...' if len(payload['text']) > 100 else payload['text']
    logger.debug(f"📤 {method} | {json.dumps(log_payload, ensure_ascii=False)}")
    
    try:
        response = requests.post(url, json=payload, timeout=30)
        result = response.json()
        
        if result.get("ok"):
            logger.debug(f"✅ {method} успешно")
        else:
            error_desc = result.get('description', 'Неизвестная ошибка')
            logger.error(f"❌ Ошибка {method}: {error_desc}")
            
        return result
    except requests.exceptions.Timeout:
        logger.error(f"⏰ Таймаут {method}")
        return {"ok": False, "error": "timeout"}
    except requests.exceptions.ConnectionError:
        logger.error(f"🔌 Ошибка подключения {method}")
        return {"ok": False, "error": "connection"}
    except Exception as e:
        logger.error(f"💥 Критическая ошибка {method}: {e}")
        logger.error(traceback.format_exc())
        return {"ok": False, "error": str(e)}

# ========== ОСНОВНЫЕ ФУНКЦИИ ==========
def send_message(chat_id, text, reply_markup=None, parse_mode="HTML"):
    payload = {
        "chat_id": chat_id,
        "text": text,
        "parse_mode": parse_mode
    }
    if reply_markup:
        payload["reply_markup"] = json.dumps(reply_markup)
    return api_request("sendMessage", payload)

def send_photo(chat_id, photo, caption=None, reply_markup=None, parse_mode="HTML"):
    payload = {
        "chat_id": chat_id,
        "photo": photo,
        "parse_mode": parse_mode
    }
    if caption:
        payload["caption"] = caption
    if reply_markup:
        payload["reply_markup"] = json.dumps(reply_markup)
    logger.info(f"📸 Отправка фото в чат {chat_id}")
    return api_request("sendPhoto", payload)

def edit_message(chat_id, message_id, text, reply_markup=None, parse_mode="HTML"):
    payload = {
        "chat_id": chat_id,
        "message_id": message_id,
        "text": text,
        "parse_mode": parse_mode
    }
    if reply_markup:
        payload["reply_markup"] = json.dumps(reply_markup)
    return api_request("editMessageText", payload)

def answer_callback(callback_id, text=None, show_alert=False):
    payload = {"callback_query_id": callback_id}
    if text:
        payload["text"] = text
    if show_alert:
        payload["show_alert"] = True
    return api_request("answerCallbackQuery", payload)

def delete_message(chat_id, message_id):
    payload = {"chat_id": chat_id, "message_id": message_id}
    return api_request("deleteMessage", payload)

