# ========== ФУНКЦИИ ==========
def send_message(chat_id, text, reply_markup=None, parse_mode="HTML"):
    """Отправка сообщения"""
    url = f"{BASE_URL}/sendMessage"
    payload = {"chat_id": chat_id, "text": text, "parse_mode": parse_mode}
    if reply_markup:
        payload["reply_markup"] = json.dumps(reply_markup)
    
    logger.debug(f"📤 send_message в {chat_id}: {text[:50]}...")
    try:
        response = requests.post(url, json=payload, timeout=30)
        result = response.json()
        if result.get("ok"):
            logger.debug(f"✅ Сообщение отправлено в {chat_id}")
        else:
            logger.error(f"❌ Ошибка send_message: {result}")
        return result
    except Exception as e:
        logger.error(f"💥 Ошибка send_message: {e}")
        return {"ok": False, "error": str(e)}

def send_photo(chat_id, photo, caption=None, reply_markup=None, parse_mode="HTML"):
    """Отправка фото"""
    url = f"{BASE_URL}/sendPhoto"
    payload = {"chat_id": chat_id, "photo": photo, "parse_mode": parse_mode}
    if caption:
        payload["caption"] = caption
    if reply_markup:
        payload["reply_markup"] = json.dumps(reply_markup)
    
    logger.debug(f"📸 send_photo в {chat_id}")
    try:
        response = requests.post(url, json=payload, timeout=30)
        result = response.json()
        if result.get("ok"):
            logger.debug(f"✅ Фото отправлено в {chat_id}")
        else:
            logger.error(f"❌ Ошибка send_photo: {result}")
        return result
    except Exception as e:
        logger.error(f"💥 Ошибка send_photo: {e}")
        return {"ok": False, "error": str(e)}

def edit_message(chat_id, message_id, text, reply_markup=None, parse_mode="HTML"):
    """Редактирование сообщения"""
    url = f"{BASE_URL}/editMessageText"
    payload = {"chat_id": chat_id, "message_id": message_id, "text": text, "parse_mode": parse_mode}
    if reply_markup:
        payload["reply_markup"] = json.dumps(reply_markup)
    
    logger.debug(f"✏️ edit_message {message_id} в {chat_id}")
    try:
        response = requests.post(url, json=payload, timeout=30)
        result = response.json()
        if result.get("ok"):
            logger.debug(f"✅ Сообщение {message_id} отредактировано")
        else:
            logger.error(f"❌ Ошибка edit_message: {result}")
        return result
    except Exception as e:
        logger.error(f"💥 Ошибка edit_message: {e}")
        return {"ok": False, "error": str(e)}

def answer_callback(callback_id, text=None, show_alert=False):
    """Ответ на нажатие кнопки (ВАЖНО!)"""
    url = f"{BASE_URL}/answerCallbackQuery"
    payload = {"callback_query_id": callback_id}
    if text:
        payload["text"] = text
    if show_alert:
        payload["show_alert"] = True
    
    try:
        response = requests.post(url, json=payload, timeout=30)
        result = response.json()
        if result.get("ok"):
            logger.debug(f"✅ answer_callback {callback_id}")
        else:
            logger.error(f"❌ Ошибка answer_callback: {result}")
        return result
    except Exception as e:
        logger.error(f"💥 Ошибка answer_callback: {e}")
        return {"ok": False, "error": str(e)}

def delete_message(chat_id, message_id):
    """Удаление сообщения"""
    url = f"{BASE_URL}/deleteMessage"
    payload = {"chat_id": chat_id, "message_id": message_id}
    try:
        response = requests.post(url, json=payload, timeout=30)
        return response.json()
    except Exception as e:
        logger.error(f"💥 Ошибка delete_message: {e}")
        return {"ok": False, "error": str(e)}

def get_username(chat_id):
    """Получение username пользователя"""
    try:
        result = requests.post(f"{BASE_URL}/getChat", json={"chat_id": chat_id}, timeout=30).json()
        if result.get("ok"):
            user = result.get("result", {})
            username = user.get("username")
            if username:
                return username
            return user.get("first_name", "Пользователь")
        return "Пользователь"
    except:
        return "Пользователь"

