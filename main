import requests
import json
import time

# ========== КОНФИГУРАЦИЯ ==========
BOT_TOKEN = "8833181446:AAFqiKedQpDm04CYP6tg4vb0MjH-k3M4GUw"
BASE_URL = f"https://api.telegram.org/bot{BOT_TOKEN}"

# ID ПРЕМИУМ-ЭМОДЗИ
EMOJI_UC = "5318970495314436977"
EMOJI_STAR = "5316970857325687050"

