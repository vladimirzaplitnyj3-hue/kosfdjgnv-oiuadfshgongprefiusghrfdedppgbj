                )
                
                # Очищаем данные
                user_data[str(user_id)]["cart"] = {}
                user_data[str(user_id)]["step"] = "main"
                user_data[str(user_id)]["temp"] = {}
                return
            
            # ---- ПОПУЛЯРНОСТЬ (ОТКРЫТЬ МЕНЮ) ----
            if data == "popularity":
                send_message(
                    chat_id,
                    f'<tg-emoji emoji-id="{E_STAR}">⭐️</tg-emoji> <b>Выберите количество популярности:</b>\n\n'
