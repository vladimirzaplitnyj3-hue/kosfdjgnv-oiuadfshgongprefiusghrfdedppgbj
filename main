        ]
    }

# ========== ЦЕНЫ ==========
UC_PRICES = {
    "60": 75,
    "325": 390,
    "660": 760,
    "1800": 1990,
    "3850": 4000,
    "8100": 8630
}

POPULARITY_PRICES = {
    "10000": 176,
    "20000": 307,
    "30000": 439,
    "40000": 578,
    "50000": 715,
    "60000": 857,
    "70000": 989,
    "100000": 1375,
    "150000": 1994,
    "200000": 2612,
    "500000": 6272
}

def get_uc_total(cart):
    total_uc = 0
    total_price = 0
    for k, v in cart.items():
        total_uc += int(k) * v
        total_price += UC_PRICES.get(k, 0) * v
    return total_uc, total_price

def get_pop_total(cart):
    total_pop = 0
    total_price = 0
    for k, v in cart.items():
        total_pop += int(k) * v
        total_price += POPULARITY_PRICES.get(k, 0) * v
    return total_pop, total_price

def get_uc_cart_text(cart):
    text = ""
    for k, v in cart.items():
        price = UC_PRICES.get(k, 0)
        text += f"• {k} UC x {v} = {price * v}₽\n"
    return text

def get_pop_cart_text(cart):
    text = ""
    for k, v in cart.items():
        formatted = f"{int(k):,}".replace(",", " ")
        price = POPULARITY_PRICES.get(k, 0)
        text += f"• {formatted} ПП x {v} = {price * v}₽\n"
    return text

# ========== ОБРАБОТКА ==========

def handle_update(update):
    try:
        # ОБРАБОТКА СООБЩЕНИЙ
        if "message" in update:
            msg = update["message"]
            chat_id = msg["chat"]["id"]
            text = msg.get("text", "")
            user_id = str(chat_id)
            
            if user_id not in user_data:
                user_data[user_id] = {"uc_cart": {}, "pop_cart": {}, "step": "main", "temp": {}}
            
            logger.info(f"💬 Сообщение от {chat_id}: {text}")
            
            if text == "/start":
                try:
                    send_photo(
                        chat_id,
                        PHOTO_URL,
                        caption="👋 Добро пожаловать в KRANZAYY UC BOT!\n\nВыберите действие:",
                        reply_markup=main_menu()
                    )
                except:
                    send_message(
                        chat_id,
                        "👋 Добро пожаловать в KRANZAYY UC BOT!\n\nВыберите действие:",
                        main_menu()
                    )
                return
            
            # Ввод PUBG ID
            if user_data[user_id].get("step") == "waiting_pubg_id":
                pubg_id = text.strip()
                if not pubg_id.isdigit() or len(pubg_id) < 5:
                    send_message(
                        chat_id,
                        "❌ Неверный формат. Введите только цифры (минимум 5):",
                        after_payment_menu()
                    )
                    return
                
                user_data[user_id]["temp"]["pubg_id"] = pubg_id
                user_data[user_id]["step"] = "main"
                
                order_type = user_data[user_id]["temp"].get("order_type", "UC")
                
                if order_type == "UC":
                    cart = user_data[user_id]["uc_cart"]
                    total_uc, total_price = get_uc_total(cart)
                    cart_text = get_uc_cart_text(cart)
                    item_name = f"{total_uc} UC"
                else:
                    cart = user_data[user_id]["pop_cart"]
                    total_pop, total_price = get_pop_total(cart)
                    cart_text = get_pop_cart_text(cart)
                    item_name = f"{total_pop} ПП"
                
                username = get_user_name(chat_id)
                order_id = f"{chat_id}_{int(time.time())}"
                
                orders[order_id] = {
                    "user_id": chat_id,
                    "total": total_uc if order_type == "UC" else total_pop,
                    "total_price": total_price,
                    "username": username,
                    "order_type": order_type,
                    "pubg_id": pubg_id
                }
                
                # Владельцу
                owner_text = (
                    f"📦 НОВЫЙ ЗАКАЗ ({order_type})\n\n"
                    f"👤 Покупатель: {username}\n"
                    f"🆔 PUBG ID: {pubg_id}\n"
                    f"📦 Товары:\n{cart_text}\n"
                    f"💰 Итого: {total_price}₽"
                )
                send_message(OWNER_ID, owner_text, owner_done_menu(order_id))
                
                # Покупателю
                send_message(
                    chat_id,
                    f"✅ Заказ подтверждён!\n\n"
                    f"📦 Товар: {item_name}\n"
                    f"💰 Сумма: {total_price}₽\n"
                    f"🆔 PUBG ID: {pubg_id}\n\n"
                    f"⏳ Время доставки: от 5 до 30 минут",
                    main_menu()
                )
                
                if order_type == "UC":
                    user_data[user_id]["uc_cart"] = {}
                else:
                    user_data[user_id]["pop_cart"] = {}
                return
        
        # ОБРАБОТКА КНОПОК
        elif "callback_query" in update:
            cb = update["callback_query"]
            chat_id = cb["message"]["chat"]["id"]
            message_id = cb["message"]["message_id"]
            data = cb["data"]
            cb_id = cb["id"]
            user_id = str(chat_id)
            
            logger.info(f"🖱 Нажата кнопка: {data}")
            
            # ОБЯЗАТЕЛЬНЫЙ ОТВЕТ НА КАЖДУЮ КНОПКУ
            answer_callback(cb_id, f"✅ Нажато: {data}")
            
            if user_id not in user_data:
                user_data[user_id] = {"uc_cart": {}, "pop_cart": {}, "step": "main", "temp": {}}
            
            # ---- НАЗАД ----
            if data == "back_to_main":
                try:
                    send_photo(chat_id, PHOTO_URL, caption="👋 Главное меню:", reply_markup=main_menu())
                    delete_message(chat_id, message_id)
                except:
                    edit_message(chat_id, message_id, "👋 Главное меню:", main_menu())
                return
            
            # ===== UC =====
            if data == "buy_uc":
                edit_message(chat_id, message_id, "🛒 Корзина UC\n\nВыберите количество UC:", uc_cart_menu())
                return
            
            if data.startswith("uc_add_"):
                amount = data.replace("uc_add_", "")
                user_data[user_id]["uc_cart"][amount] = user_data[user_id]["uc_cart"].get(amount, 0) + 1
                total_uc, total_price = get_uc_total(user_data[user_id]["uc_cart"])
                
                cart = user_data[user_id]["uc_cart"]
                text = f"🛒 Корзина UC\n\n"
                if cart:
                    text += get_uc_cart_text(cart)
                    text += f"\n📦 Итого: {total_uc} UC — {total_price}₽"
                else:
                    text += "Пусто"
                edit_message(chat_id, message_id, text, uc_cart_menu())
                return
            
            if data == "uc_clear_cart":
                user_data[user_id]["uc_cart"] = {}
                edit_message(chat_id, message_id, "🛒 Корзина UC\n\nПусто", uc_cart_menu())
                return
            
            if data == "uc_checkout":
                cart = user_data[user_id]["uc_cart"]
                if not cart:
                    answer_callback(cb_id, "❌ Корзина пуста!", True)
                    return
                
                user_data[user_id]["temp"]["order_type"] = "UC"
                total_uc, total_price = get_uc_total(cart)
                cart_text = get_uc_cart_text(cart)
                
                payment_text = (
                    f"💳 Оплата заказа UC\n\n"
                    f"📦 Товары:\n{cart_text}\n"
                    f"💰 Итого: {total_price}₽\n\n"
                    f"Способы оплаты:\n\n"
                    f"💳 По номеру карты (Сбербанк):\n"
                    f"2202208555983213\n\n"
                    f"📱 По номеру телефона (Сбербанк):\n"
                    f"+7 952 321-66-09\n\n"
                    f"Оплатите и нажмите «Я оплатил»."
                )
                edit_message(chat_id, message_id, payment_text, payment_menu())
                return
            
            # ===== ПОПУЛЯРНОСТЬ =====
            if data == "popularity":
                edit_message(chat_id, message_id, "⭐️ Корзина популярности\n\nВыберите количество ПП:", popularity_cart_menu())
                return
            
            if data.startswith("pop_add_"):
                amount = data.replace("pop_add_", "")
                user_data[user_id]["pop_cart"][amount] = user_data[user_id]["pop_cart"].get(amount, 0) + 1
                total_pop, total_price = get_pop_total(user_data[user_id]["pop_cart"])
                formatted = f"{int(amount):,}".replace(",", " ")
                
                cart = user_data[user_id]["pop_cart"]
                text = f"⭐️ Корзина популярности\n\n"
                if cart:
                    text += get_pop_cart_text(cart)
                    text += f"\n📦 Итого: {total_pop} ПП — {total_price}₽"
                else:
                    text += "Пусто"
                edit_message(chat_id, message_id, text, popularity_cart_menu())
                return
            
            if data == "pop_clear_cart":
                user_data[user_id]["pop_cart"] = {}
                edit_message(chat_id, message_id, "⭐️ Корзина популярности\n\nПусто", popularity_cart_menu())
                return
            
            if data == "pop_checkout":
                cart = user_data[user_id]["pop_cart"]
                if not cart:
                    answer_callback(cb_id, "❌ Корзина пуста!", True)
                    return
                
                user_data[user_id]["temp"]["order_type"] = "ПП"
                total_pop, total_price = get_pop_total(cart)
                cart_text = get_pop_cart_text(cart)
                
                payment_text = (
                    f"💳 Оплата заказа популярности\n\n"
                    f"📦 Товары:\n{cart_text}\n"
                    f"💰 Итого: {total_price}₽\n\n"
                    f"Способы оплаты:\n\n"
                    f"💳 По номеру карты (Сбербанк):\n"
                    f"2202208555983213\n\n"
                    f"📱 По номеру телефона (Сбербанк):\n"
                    f"+7 952 321-66-09\n\n"
                    f"Оплатите и нажмите «Я оплатил»."
                )
                edit_message(chat_id, message_id, payment_text, payment_menu())
                return
            
            # ---- ОПЛАТА ----
            if data == "i_paid":
                order_type = user_data[user_id]["temp"].get("order_type", "UC")
                
                if order_type == "UC":
                    cart = user_data[user_id]["uc_cart"]
                    total_uc, total_price = get_uc_total(cart)
                    cart_text = get_uc_cart_text(cart)
                else:
                    cart = user_data[user_id]["pop_cart"]
                    total_pop, total_price = get_pop_total(cart)
                    cart_text = get_pop_cart_text(cart)
                
                username = get_user_name(chat_id)
                order_id = f"{chat_id}_{int(time.time())}"
                
                orders[order_id] = {
                    "user_id": chat_id,
                    "total": total_uc if order_type == "UC" else total_pop,
                    "total_price": total_price,
                    "username": username,
                    "order_type": order_type
                }
                
                owner_text = (
                    f"💰 ПОДТВЕРЖДЕНИЕ ОПЛАТЫ ({order_type})\n\n"
                    f"👤 Покупатель: {username}\n"
                    f"📦 Товары:\n{cart_text}\n"
                    f"💰 Итого: {total_price}₽"
                )
                send_message(OWNER_ID, owner_text)
                
                send_message(
                    chat_id,
                    f"✅ Ваша оплата подтверждена!\n\n"
                    f"🆔 Введите ваш PUBG ID:",
                    after_payment_menu()
                )
                user_data[user_id]["step"] = "waiting_pubg_id"
                return
            
            if data == "cancel_payment":
                user_data[user_id]["uc_cart"] = {}
                user_data[user_id]["pop_cart"] = {}
                user_data[user_id]["step"] = "main"
                user_data[user_id]["temp"] = {}
                edit_message(chat_id, message_id, "❌ Заказ отменён", main_menu())
                return
            
            # ---- ВЫПОЛНЕНИЕ ЗАКАЗА ----
            if data.startswith("order_done_"):
                order_id = data.replace("order_done_", "")
                order = orders.get(order_id)
                if not order:
                    answer_callback(cb_id, "❌ Заказ не найден", True)
                    return
                
                user_id = order["user_id"]
                total = order["total"]
                order_type = order.get("order_type", "UC")
                pubg_id = order.get("pubg_id", "Не указан")
                
                send_message(
                    user_id,
                    f"🎉 Ваш заказ выполнен!\n\n"
                    f"📦 Товар: {total} {order_type}\n"
                    f"🆔 PUBG ID: {pubg_id}\n\n"
                    f"❤️‍🔥 Спасибо за покупку!",
                    main_menu()
                )
                
                edit_message(chat_id, message_id, f"✅ Заказ {order_id} выполнен!", main_menu())
                return
            
            # ---- ИНФОРМАЦИЯ ----
            if data == "info":
                text = (
                    "ℹ️ KRANZAYY UC BOT\n\n"
                    "Наш бот работает для вас ❤️‍🔥\n\n"
                    "Наши ресурсы:\n"
                    "🛒 Магазин - https://t.me/kranzayyuc\n"
                    "📢 Канал - https://t.me/KRANZAYY_STORE\n"
                    "⭐ Отзывы - https://t.me/Kranzayy_OTZ\n\n"
                    "🆘 Поддержка: @M_K_B_59"
                )
                edit_message(chat_id, message_id, text, main_menu())
                return
            
            logger.warning(f"⚠️ Неизвестная кнопка: {data}")
    
    except Exception as e:
        logger.error(f"💥 ОШИБКА: {e}")
        logger.error(traceback.format_exc())

# ========== ЗАПУСК ==========

def main():
    offset = None
    logger.info("=" * 50)
    logger.info("🚀 БОТ ЗАПУЩЕН (УПРОЩЁННАЯ ВЕРСИЯ)")
    logger.info("✅ КАЖДАЯ КНОПКА ОТВЕЧАЕТ answer_callback")
    logger.info("=" * 50)
    
    while True:
        try:
            response = requests.get(
                f"{BASE_URL}/getUpdates",
                params={"timeout": 30, "offset": offset},
                timeout=35
            ).json()
            
            if response.get("ok"):
                for update in response.get("result", []):
                    handle_update(update)
                    offset = update["update_id"] + 1
            else:
                logger.error(f"❌ Ошибка: {response}")
            
            time.sleep(0.5)
        except Exception as e:
            logger.error(f"💥 Ошибка: {e}")
            time.sleep(10)

if __name__ == "__main__":
    main()
