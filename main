                if not result.get("ok"):
                    logger.error(f"❌ Ошибка edit_message: {result}")
                answer_callback(cb_id)
                return
            
            # ---- НЕИЗВЕСТНО ----
            logger.warning(f"⚠️ Неизвестная кнопка: {data}")
            answer_callback(cb_id, "❌ Неизвестная команда")
    
    except Exception as e:
        logger.error(f"💥 КРИТИЧЕСКАЯ ОШИБКА В HANDLE_UPDATE: {e}")
        logger.error(traceback.format_exc())

# ========== ЗАПУСК ==========

def main():
    offset = None
    logger.info("=" * 50)
    logger.info("🚀 БОТ ЗАПУЩЕН С ЛОГИРОВАНИЕМ")
    logger.info(f"📸 Фото: {PHOTO_URL}")
    logger.info(f"💎 Премиум-эмодзи: UC={EMOJI_UC}, STAR={EMOJI_STAR}")
    logger.info("=" * 50)
    
    while True:
        try:
            response = requests.get(
                f"{BASE_URL}/getUpdates",
                params={"timeout": 30, "offset": offset},
                timeout=35
            ).json()
            
            if response.get("ok"):
                for update in response.get("result", []):
                    handle_update(update)
                    offset = update["update_id"] + 1
            else:
                logger.error(f"❌ Ошибка getUpdates: {response}")
            
            time.sleep(0.5)
        
        except requests.exceptions.Timeout:
            logger.warning("⏰ Таймаут getUpdates, переподключение...")
            time.sleep(2)
        except requests.exceptions.ConnectionError:
            logger.error("🔌 Ошибка подключения к Telegram API")
            time.sleep(10)
        except Exception as e:
            logger.error(f"💥 КРИТИЧЕСКАЯ ОШИБКА В MAIN: {e}")
            logger.error(traceback.format_exc())
            time.sleep(10)

if __name__ == "__main__":
    main()
