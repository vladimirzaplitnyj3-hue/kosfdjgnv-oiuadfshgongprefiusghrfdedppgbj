                    cart = user_data[user_id]["pop_cart"]
                    total = sum(int(k) * v for k, v in cart.items())
                    price = sum(POP_PRICES.get(k, 0) * v for k, v in cart.items())
                    cart_text = ""
                    for k, v in cart.items():
                        formatted = f"{int(k):,}".replace(",", " ")
                        cart_text += f"• {formatted} ПП x {v} = {POP_PRICES.get(k, 0) * v}₽\n"
                
