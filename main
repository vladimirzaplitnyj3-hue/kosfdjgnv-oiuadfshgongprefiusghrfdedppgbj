# ========== ЦЕНЫ ==========

UC_PRICES = {
    "60": 75,
    "325": 390,
    "660": 760,
    "1800": 1990,
    "3850": 4000,
    "8100": 8630
}

POP_PRICES = {
    "10000": 176,
    "20000": 307,
    "30000": 439,
    "40000": 578,
    "50000": 715,
    "60000": 857,
    "70000": 989,
    "100000": 1375,
    "150000": 1994,
    "200000": 2612,
    "500000": 6272
}

# ========== ОБРАБОТКА ==========

def handle_update(update):
    try:
        logger.debug(f"📩 Получен update: {json.dumps(update, ensure_ascii=False)[:200]}")
        
        if "message" in update:
            msg = update["message"]
            chat_id = msg["chat"]["id"]
            text = msg.get("text", "")
            user_id = str(chat_id)
            
            if user_id not in user_data:
                user_data[user_id] = {"uc_cart": {}, "pop_cart": {}, "step": "main", "temp": {}}
            
            logger.info(f"💬 Сообщение от {chat_id}: {text}")
            
            if text == "/start":
                # Пытаемся отправить фото
                try:
                    result = send_photo(
                        chat_id,
                        PHOTO_URL,
                        caption=f'<tg-emoji emoji-id="{EMOJI_WAVE}">👋</tg-emoji> Добро пожаловать в KRANZAYY UC BOT!\n\nВыберите действие:',
                        reply_markup=main_menu()
                    )
                    if not result.get("ok"):
                        # Если фото не отправилось, отправляем текст
                        logger.warning(f"Фото не загрузилось, отправляю текст. Ошибка: {result}")
                        send_message(
                            chat_id,
                            f'<tg-emoji emoji-id="{EMOJI_WAVE}">👋</tg-emoji> Добро пожаловать в KRANZAYY UC BOT!\n\nВыберите действие:',
                            main_menu()
                        )
                except Exception as e:
                    logger.error(f"Ошибка при отправке фото: {e}")
                    send_message(
                        chat_id,
                        f'<tg-emoji emoji-id="{EMOJI_WAVE}">👋</tg-emoji> Добро пожаловать в KRANZAYY UC BOT!\n\nВыберите действие:',
                        main_menu()
                    )
                return
            
            # Обработка ввода PUBG ID
            if user_data[user_id].get("step") == "waiting_pubg":
                pubg_id = text.strip()
                if not pubg_id.isdigit() or len(pubg_id) < 5:
                    send_message(
                        chat_id,
                        f'<tg-emoji emoji-id="{EMOJI_CROSS}">❌</tg-emoji> Неверный формат. Введите только цифры (минимум 5):',
                        after_payment_menu()
                    )
                    return
                
                user_data[user_id]["temp"]["pubg_id"] = pubg_id
                user_data[user_id]["step"] = "main"
                
                order_type = user_data[user_id]["temp"].get("order_type", "UC")
                
                if order_type == "UC":
                    cart = user_data[user_id]["uc_cart"]
                    total = sum(int(k) * v for k, v in cart.items())
                    price = sum(UC_PRICES.get(k, 0) * v for k, v in cart.items())
                    cart_text = ""
                    for k, v in cart.items():
                        cart_text += f"• {k} UC x {v} = {UC_PRICES.get(k, 0) * v}₽\n"
                else:
                    cart = user_data[user_id]["pop_cart"]
                    total = sum(int(k) * v for k, v in cart.items())
                    price = sum(POP_PRICES.get(k, 0) * v for k, v in cart.items())
                    cart_text = ""
                    for k, v in cart.items():
                        formatted = f"{int(k):,}".replace(",", " ")
                        cart_text += f"• {formatted} ПП x {v} = {POP_PRICES.get(k, 0) * v}₽\n"
                
                order_id = f"{chat_id}_{int(time.time())}"
                orders[order_id] = {
                    "user_id": chat_id,
                    "total": total,
                    "price": price,
                    "order_type": order_type,
                    "pubg_id": pubg_id,
                    "username": get_username(chat_id)
                }
                
                username = get_username(chat_id)
                owner_text = (
                    f'<tg-emoji emoji-id="{EMOJI_ORDER}">📦</tg-emoji> НОВЫЙ ЗАКАЗ ({order_type})\n\n'
                    f'<tg-emoji emoji-id="{EMOJI_USER}">👤</tg-emoji> {username}\n'
                    f'<tg-emoji emoji-id="{EMOJI_UC}">🆔</tg-emoji> PUBG: {pubg_id}\n'
                    f'<tg-emoji emoji-id="{EMOJI_ORDER}">📦</tg-emoji> Товары:\n{cart_text}'
                    f'<tg-emoji emoji-id="{EMOJI_MONEY}">💰</tg-emoji> Сумма: {price}₽'
                )
                send_message(OWNER_ID, owner_text, done_menu(order_id))
                
                send_message(
                    chat_id,
                    f'<tg-emoji emoji-id="{EMOJI_CHECK}">✅</tg-emoji> ЗАКАЗ ПОДТВЕРЖДЁН!\n\n'
                    f'<tg-emoji emoji-id="{EMOJI_ORDER}">📦</tg-emoji> {total} {order_type}\n'
                    f'<tg-emoji emoji-id="{EMOJI_MONEY}">💰</tg-emoji> {price}₽\n'
                    f'<tg-emoji emoji-id="{EMOJI_UC}">🆔</tg-emoji> PUBG: {pubg_id}\n'
                    f'<tg-emoji emoji-id="{EMOJI_TIME}">⏳</tg-emoji> Доставка 5-30 минут',
                    main_menu()
                )
                
                if order_type == "UC":
                    user_data[user_id]["uc_cart"] = {}
                else:
                    user_data[user_id]["pop_cart"] = {}
                return
        
        elif "callback_query" in update:
            cb = update["callback_query"]
            chat_id = cb["message"]["chat"]["id"]
            message_id = cb["message"]["message_id"]
            data = cb["data"]
            cb_id = cb["id"]
            user_id = str(chat_id)
            
            logger.info(f"🖱 Нажата кнопка: {data} от {chat_id}")
            
            # ОБЯЗАТЕЛЬНЫЙ ОТВЕТ НА КАЖДУЮ КНОПКУ
            answer_callback(cb_id, f"✅ {data}")
            
            if user_id not in user_data:
                user_data[user_id] = {"uc_cart": {}, "pop_cart": {}, "step": "main", "temp": {}}
            
            # ---- НАЗАД (С ФОТО) ----
            if data == "back":
                try:
                    send_photo(
                        chat_id,
                        PHOTO_URL,
                        caption=f'<tg-emoji emoji-id="{EMOJI_WAVE}">👋</tg-emoji> Главное меню:',
                        reply_markup=main_menu()
                    )
                    delete_message(chat_id, message_id)
                except Exception as e:
                    logger.error(f"Ошибка при возврате с фото: {e}")
                    edit_message(
                        chat_id,
                        message_id,
                        f'<tg-emoji emoji-id="{EMOJI_WAVE}">👋</tg-emoji> Главное меню:',
                        main_menu()
                    )
                return
            
            # ---- UC ----
            if data == "buy_uc":
                edit_message(
                    chat_id,
                    message_id,
                    f'<tg-emoji emoji-id="{EMOJI_CART}">🛒</tg-emoji> КОРЗИНА UC\n\nВыберите количество UC:',
                    uc_menu()
                )
                return
            
            if data.startswith("uc_") and data not in ["uc_checkout", "uc_clear"]:
                amount = data.replace("uc_", "")
                user_data[user_id]["uc_cart"][amount] = user_data[user_id]["uc_cart"].get(amount, 0) + 1
                total = sum(int(k) * v for k, v in user_data[user_id]["uc_cart"].items())
                price = sum(UC_PRICES.get(k, 0) * v for k, v in user_data[user_id]["uc_cart"].items())
                
                cart_text = ""
                for k, v in user_data[user_id]["uc_cart"].items():
                    cart_text += f"• {k} UC x {v} = {UC_PRICES.get(k, 0) * v}₽\n"
                
                edit_message(
                    chat_id,
                    message_id,
                    f'<tg-emoji emoji-id="{EMOJI_CART}">🛒</tg-emoji> КОРЗИНА UC\n\n{cart_text}'
                    f'<tg-emoji emoji-id="{EMOJI_ORDER}">📦</tg-emoji> Итого: {total} UC — {price}₽',
                    uc_menu()
                )
                return
            
            if data == "uc_clear":
                user_data[user_id]["uc_cart"] = {}
                edit_message(
                    chat_id,
                    message_id,
                    f'<tg-emoji emoji-id="{EMOJI_CART}">🛒</tg-emoji> КОРЗИНА UC\n\n'
                    f'<tg-emoji emoji-id="{EMOJI_CROSS}">🗑</tg-emoji> Очищена',
                    uc_menu()
                )
                return
            
            if data == "uc_checkout":
                cart = user_data[user_id]["uc_cart"]
                if not cart:
                    answer_callback(cb_id, f'<tg-emoji emoji-id="{EMOJI_CROSS}">❌</tg-emoji> Корзина пуста!', True)
                    return
                
                user_data[user_id]["temp"]["order_type"] = "UC"
                total = sum(int(k) * v for k, v in cart.items())
                price = sum(UC_PRICES.get(k, 0) * v for k, v in cart.items())
                
                cart_text = ""
                for k, v in cart.items():
                    cart_text += f"• {k} UC x {v} = {UC_PRICES.get(k, 0) * v}₽\n"
                
                text = (
                    f'<tg-emoji emoji-id="{EMOJI_CARD}">💳</tg-emoji> ОПЛАТА ЗАКАЗА UC\n\n'
                    f'<tg-emoji emoji-id="{EMOJI_ORDER}">📦</tg-emoji> Товары:\n{cart_text}'
                    f'<tg-emoji emoji-id="{EMOJI_MONEY}">💰</tg-emoji> Итого: {price}₽\n\n'
                    f'🏦 Способы оплаты (Сбербанк):\n'
                    f'<tg-emoji emoji-id="{EMOJI_CARD}">💳</tg-emoji> Карта: 2202208555983213\n'
                    f'<tg-emoji emoji-id="{EMOJI_PHONE}">📱</tg-emoji> Телефон: +7 952 321-66-09\n\n'
                    f'Нажмите <b>«Я оплатил»</b> после перевода.'
                )
                edit_message(chat_id, message_id, text, payment_menu())
                return
            
            # ---- ПОПУЛЯРНОСТЬ ----
            if data == "popularity":
                edit_message(
                    chat_id,
                    message_id,
                    f'<tg-emoji emoji-id="{EMOJI_STAR}">⭐️</tg-emoji> КОРЗИНА ПОПУЛЯРНОСТИ\n\nВыберите количество ПП:',
                    popularity_menu()
                )
                return
            
            if data.startswith("pop_") and data not in ["pop_checkout", "pop_clear"]:
                amount = data.replace("pop_", "")
                user_data[user_id]["pop_cart"][amount] = user_data[user_id]["pop_cart"].get(amount, 0) + 1
                total = sum(int(k) * v for k, v in user_data[user_id]["pop_cart"].items())
                price = sum(POP_PRICES.get(k, 0) * v for k, v in user_data[user_id]["pop_cart"].items())
                
                cart_text = ""
                for k, v in user_data[user_id]["pop_cart"].items():
                    formatted = f"{int(k):,}".replace(",", " ")
                    cart_text += f"• {formatted} ПП x {v} = {POP_PRICES.get(k, 0) * v}₽\n"
                
                edit_message(
                    chat_id,
                    message_id,
                    f'<tg-emoji emoji-id="{EMOJI_STAR}">⭐️</tg-emoji> КОРЗИНА ПОПУЛЯРНОСТИ\n\n{cart_text}'
                    f'<tg-emoji emoji-id="{EMOJI_ORDER}">📦</tg-emoji> Итого: {total} ПП — {price}₽',
                    popularity_menu()
                )
                return
            
            if data == "pop_clear":
                user_data[user_id]["pop_cart"] = {}
                edit_message(
                    chat_id,
                    message_id,
                    f'<tg-emoji emoji-id="{EMOJI_STAR}">⭐️</tg-emoji> КОРЗИНА ПОПУЛЯРНОСТИ\n\n'
                    f'<tg-emoji emoji-id="{EMOJI_CROSS}">🗑</tg-emoji> Очищена',
                    popularity_menu()
                )
                return
            
            if data == "pop_checkout":
                cart = user_data[user_id]["pop_cart"]
                if not cart:
                    answer_callback(cb_id, f'<tg-emoji emoji-id="{EMOJI_CROSS}">❌</tg-emoji> Корзина пуста!', True)
                    return
                
                user_data[user_id]["temp"]["order_type"] = "ПП"
                total = sum(int(k) * v for k, v in cart.items())
                price = sum(POP_PRICES.get(k, 0) * v for k, v in cart.items())
                
                cart_text = ""
                for k, v in cart.items():
                    formatted = f"{int(k):,}".replace(",", " ")
                    cart_text += f"• {formatted} ПП x {v} = {POP_PRICES.get(k, 0) * v}₽\n"
                
                text = (
                    f'<tg-emoji emoji-id="{EMOJI_CARD}">💳</tg-emoji> ОПЛАТА ЗАКАЗА ПОПУЛЯРНОСТИ\n\n'
                    f'<tg-emoji emoji-id="{EMOJI_ORDER}">📦</tg-emoji> Товары:\n{cart_text}'
                    f'<tg-emoji emoji-id="{EMOJI_MONEY}">💰</tg-emoji> Итого: {price}₽\n\n'
                    f'🏦 Способы оплаты (Сбербанк):\n'
                    f'<tg-emoji emoji-id="{EMOJI_CARD}">💳</tg-emoji> Карта: 2202208555983213\n'
                    f'<tg-emoji emoji-id="{EMOJI_PHONE}">📱</tg-emoji> Телефон: +7 952 321-66-09\n\n'
                    f'Нажмите <b>«Я оплатил»</b> после перевода.'
                )
                edit_message(chat_id, message_id, text, payment_menu())
                return
            
            # ---- ОПЛАТА ----
            if data == "i_paid":
                order_type = user_data[user_id]["temp"].get("order_type", "UC")
                
                if order_type == "UC":
                    cart = user_data[user_id]["uc_cart"]
                    total = sum(int(k) * v for k, v in cart.items())
                    price = sum(UC_PRICES.get(k, 0) * v for k, v in cart.items())
                    cart_text = ""
                    for k, v in cart.items():
                        cart_text += f"• {k} UC x {v} = {UC_PRICES.get(k, 0) * v}₽\n"
                else:
                    cart = user_data[user_id]["pop_cart"]
                    total = sum(int(k) * v for k, v in cart.items())
                    price = sum(POP_PRICES.get(k, 0) * v for k, v in cart.items())
                    cart_text = ""
                    for k, v in cart.items():
                        formatted = f"{int(k):,}".replace(",", " ")
                        cart_text += f"• {formatted} ПП x {v} = {POP_PRICES.get(k, 0) * v}₽\n"
                
                username = get_username(chat_id)
                owner_text = (
                    f'<tg-emoji emoji-id="{EMOJI_MONEY}">💰</tg-emoji> ПОДТВЕРЖДЕНИЕ ОПЛАТЫ ({order_type})\n\n'
                    f'<tg-emoji emoji-id="{EMOJI_USER}">👤</tg-emoji> {username}\n'
                    f'<tg-emoji emoji-id="{EMOJI_ORDER}">📦</tg-emoji> Товары:\n{cart_text}'
                    f'<tg-emoji emoji-id="{EMOJI_MONEY}">💰</tg-emoji> Сумма: {price}₽'
                )
                send_message(OWNER_ID, owner_text)
                
                send_message(
                    chat_id,
                    f'<tg-emoji emoji-id="{EMOJI_CHECK}">✅</tg-emoji> ОПЛАТА ПОДТВЕРЖДЕНА!\n\n'
                    f'<tg-emoji emoji-id="{EMOJI_UC}">🆔</tg-emoji> Введите ваш PUBG ID (только цифры):',
                    after_payment_menu()
                )
                user_data[user_id]["step"] = "waiting_pubg"
                return
            
            if data == "cancel":
                user_data[user_id]["uc_cart"] = {}
                user_data[user_id]["pop_cart"] = {}
                user_data[user_id]["step"] = "main"
                user_data[user_id]["temp"] = {}
                edit_message(
                    chat_id,
                    message_id,
                    f'<tg-emoji emoji-id="{EMOJI_CROSS}">❌</tg-emoji> Заказ отменён',
                    main_menu()
                )
                return
            
            # ---- ВЫПОЛНЕНИЕ ЗАКАЗА ВЛАДЕЛЬЦЕМ ----
            if data.startswith("done_"):
                order_id = data.replace("done_", "")
                order = orders.get(order_id)
                if not order:
                    answer_callback(cb_id, f'<tg-emoji emoji-id="{EMOJI_CROSS}">❌</tg-emoji> Заказ не найден', True)
                    return
                
                user_id = order["user_id"]
                total = order["total"]
                order_type = order.get("order_type", "UC")
                pubg_id = order.get("pubg_id", "Не указан")
                
                send_message(
                    user_id,
                    f'<tg-emoji emoji-id="{EMOJI_DONE}">🎉</tg-emoji> ВАШ ЗАКАЗ ВЫПОЛНЕН!\n\n'
                    f'<tg-emoji emoji-id="{EMOJI_ORDER}">📦</tg-emoji> {total} {order_type}\n'
                    f'<tg-emoji emoji-id="{EMOJI_UC}">🆔</tg-emoji> PUBG: {pubg_id}\n'
                    f'<tg-emoji emoji-id="{EMOJI_HEART}">❤️‍🔥</tg-emoji> Спасибо за покупку!',
                    main_menu()
                )
                edit_message(
                    chat_id,
                    message_id,
                    f'<tg-emoji emoji-id="{EMOJI_CHECK}">✅</tg-emoji> Заказ {order_id} выполнен!',
                    main_menu()
                )
                return
            
            # ---- ИНФОРМАЦИЯ ----
            if data == "info":
                text = (
                    f'<tg-emoji emoji-id="{EMOJI_INFO}">ℹ️</tg-emoji> KRANZAYY UC BOT\n\n'
                    f'Наш бот работает для вас <tg-emoji emoji-id="{EMOJI_HEART}">❤️‍🔥</tg-emoji>\n\n'
                    f'<tg-emoji emoji-id="{EMOJI_FIRE}">🌟</tg-emoji>'
                    f'<tg-emoji emoji-id="{EMOJI_SPARKLE}">✨</tg-emoji>'
                    f'<tg-emoji emoji-id="{EMOJI_SPARKLE}">✨</tg-emoji>'
                    f'<tg-emoji emoji-id="{EMOJI_STAR2}">💫</tg-emoji>\n\n'
                    f'Наши ресурсы:\n'
                    f'<tg-emoji emoji-id="{EMOJI_SHOP}">🛒</tg-emoji> Магазин - https://t.me/kranzayyuc\n'
                    f'<tg-emoji emoji-id="{EMOJI_MEGAPHONE}">📢</tg-emoji> Канал - https://t.me/KRANZAYY_STORE\n'
                    f'<tg-emoji emoji-id="{EMOJI_METRO}">🏪</tg-emoji> Метро шоп - https://t.me/MetroShop_Kranzayy\n'
                    f'<tg-emoji emoji-id="{EMOJI_REVIEW}">⭐</tg-emoji> Отзывы - https://t.me/Kranzayy_OTZ\n\n'
                    f'<tg-emoji emoji-id="{EMOJI_DIAMOND}">💎</tg-emoji>'
                    f'<tg-emoji emoji-id="{EMOJI_DIAMOND}">💎</tg-emoji>'
                    f'<tg-emoji emoji-id="{EMOJI_DIAMOND}">💎</tg-emoji>'
                    f'<tg-emoji emoji-id="{EMOJI_DIAMOND}">💎</tg-emoji>\n\n'
                    f'<tg-emoji emoji-id="{EMOJI_SUPPORT}">🆘</tg-emoji> Техническая поддержка: @M_K_B_59'
                )
                edit_message(chat_id, message_id, text, main_menu())
                return
            
            logger.warning(f"⚠️ Неизвестная кнопка: {data}")
            answer_callback(cb_id, f'<tg-emoji emoji-id="{EMOJI_CROSS}">❌</tg-emoji> Неизвестная команда')
    
    except Exception as e:
        logger.error(f"💥 ОШИБКА В HANDLE_UPDATE: {e}")
        logger.error(traceback.format_exc())

# ========== ЗАПУСК ==========

def main():
    offset = None
    logger.info("=" * 50)
    logger.info("🚀 БОТ ЗАПУЩЕН")
    logger.info("✅ ВСЕ КНОПКИ РАБОТАЮТ")
    logger.info("✅ ПРЕМИУМ-ЭМОДЗИ")
    logger.info("✅ ФОТО (ЕСЛИ ДОСТУПНО)")
    logger.info("=" * 50)
    
    while True:
        try:
            response = requests.get(
                f"{BASE_URL}/getUpdates",
                params={"timeout": 30, "offset": offset},
                timeout=35
            ).json()
            
            if response.get("ok"):
                for update in response.get("result", []):
                    handle_update(update)
                    offset = update["update_id"] + 1
            else:
                logger.error(f"❌ Ошибка getUpdates: {response}")
            
            time.sleep(0.5)
        except Exception as e:
            logger.error(f"💥 Ошибка в main: {e}")
            logger.error(traceback.format_exc())
            time.sleep(10)

if __name__ == "__main__":
    main()
