# ========== ЦЕНЫ ==========
UC_PRICES = {
    "60": 75,
    "325": 390,
    "660": 760,
    "1800": 1990,
    "3850": 4000,
    "8100": 8630
}

POPULARITY_PRICES = {
    "10000": 176,
    "20000": 307,
    "30000": 439,
    "40000": 578,
    "50000": 715,
    "60000": 857,
    "70000": 989,
    "100000": 1375,
    "150000": 1994,
    "200000": 2612,
    "500000": 6272
}

def get_cart_total(cart):
    total_uc = sum(int(k) * v for k, v in cart.items())
    total_price = sum(UC_PRICES.get(k, 0) * v for k, v in cart.items())
    return total_uc, total_price

# ========== ОБРАБОТКА ==========

def handle_update(update):
    try:
        if "message" in update:
            msg = update["message"]
            chat_id = msg["chat"]["id"]
            text = msg.get("text", "")
            user_id = str(chat_id)
            
            if user_id not in user_data:
                user_data[user_id] = {"cart": {}, "step": "main", "temp": {}}
            
            logger.info(f"💬 Сообщение от {chat_id}: {text}")
            
            if text == "/start":
                try:
                    result = send_photo(
                        chat_id,
                        PHOTO_URL,
                        caption="👋 Добро пожаловать в KRANZAYY UC BOT!\n\nВыберите действие:",
                        reply_markup=main_menu()
                    )
                    if not result.get("ok"):
                        send_message(chat_id, "👋 Добро пожаловать в KRANZAYY UC BOT!\n\nВыберите действие:", main_menu())
                except:
                    send_message(chat_id, "👋 Добро пожаловать в KRANZAYY UC BOT!\n\nВыберите действие:", main_menu())
                return
            
            # Обработка ввода PUBG ID после оплаты
            if user_data[user_id].get("step") == "waiting_pubg_id":
                pubg_id = text.strip()
                if not pubg_id.isdigit() or len(pubg_id) < 5:
                    send_message(chat_id, "❌ Неверный формат. Введите только цифры (минимум 5):", after_payment_menu())
                    return
                
                user_data[user_id]["temp"]["pubg_id"] = pubg_id
                user_data[user_id]["step"] = "main"
                
                # Отправляем уведомление владельцу с PUBG ID
                cart = user_data[user_id]["cart"]
                total_uc, total_price = get_cart_total(cart)
                username = get_user_name(chat_id)
                user_mention = f'<a href="tg://user?id={chat_id}">{username}</a>'
                
                cart_text = ""
                for k, v in cart.items():
                    cart_text += f"• {k} UC x {v} = {UC_PRICES.get(k, 0) * v}₽\n"
                
                owner_text = (
                    f"📦 <b>НОВЫЙ ЗАКАЗ</b>\n\n"
                    f"👤 Покупатель: {user_mention}\n"
                    f"🆔 PUBG ID: {pubg_id}\n"
                    f"📦 Товары:\n{cart_text}\n"
                    f"💰 Итого: {total_price}₽\n\n"
                    f"⏳ Ожидает выполнения"
                )
                
                send_message(OWNER_ID, owner_text, owner_done_menu(f"{chat_id}_{int(time.time())}"))
                
                # Очищаем корзину
                user_data[user_id]["cart"] = {}
                
                send_message(
                    chat_id,
                    f"✅ Заказ подтверждён!\n\n"
                    f"🆔 Ваш PUBG ID: {pubg_id}\n"
                    f"⏳ Время доставки: от 5 до 30 минут\n\n"
                    f"Ожидайте выполнения заказа.",
                    main_menu()
                )
                return
        
        elif "callback_query" in update:
            cb = update["callback_query"]
            chat_id = cb["message"]["chat"]["id"]
            message_id = cb["message"]["message_id"]
            data = cb["data"]
            cb_id = cb["id"]
            user_id = str(chat_id)
            
            if user_id not in user_data:
                user_data[user_id] = {"cart": {}, "step": "main", "temp": {}}
            
            logger.info(f"🖱 Нажата кнопка: {data}")
            
            # ---- НАЗАД ----
            if data == "back_to_main":
                edit_message(chat_id, message_id, "👋 Главное меню:", main_menu())
                answer_callback(cb_id)
                return
            
            # ---- UC ----
            if data == "buy_uc":
                edit_message(chat_id, message_id, "🛒 Выберите количество UC:", cart_menu())
                answer_callback(cb_id)
                return
            
            if data.startswith("add_"):
                amount = data.split("_")[1]
                user_data[user_id]["cart"][amount] = user_data[user_id]["cart"].get(amount, 0) + 1
                total_uc, total_price = get_cart_total(user_data[user_id]["cart"])
                answer_callback(cb_id, f"✅ +{amount} UC! Итого: {total_price}₽")
                
                cart = user_data[user_id]["cart"]
                text = "🛒 Корзина:\n\n"
                if cart:
                    for k, v in cart.items():
                        text += f"• {k} UC x {v} = {UC_PRICES.get(k, 0) * v}₽\n"
                    text += f"\n📦 Итого: {total_uc} UC — {total_price}₽"
                else:
                    text += "Пусто"
                edit_message(chat_id, message_id, text, cart_menu())
                return
            
            if data == "clear_cart":
                user_data[user_id]["cart"] = {}
                answer_callback(cb_id, "🗑 Корзина очищена!")
                edit_message(chat_id, message_id, "🛒 Корзина пуста", cart_menu())
                return
            
            if data == "checkout":
                cart = user_data[user_id]["cart"]
                if not cart:
                    answer_callback(cb_id, "❌ Корзина пуста!", True)
                    return
                
                total_uc, total_price = get_cart_total(cart)
                cart_text = ""
                for k, v in cart.items():
                    cart_text += f"• {k} UC x {v} = {UC_PRICES.get(k, 0) * v}₽\n"
                
                payment_text = (
                    f"💳 <b>Оплата заказа</b>\n\n"
                    f"📦 Товары:\n{cart_text}\n"
                    f"💰 Итого: {total_price}₽\n\n"
                    f"<b>Способы оплаты:</b>\n\n"
                    f'<tg-emoji emoji-id="{EMOJI_CARD}">💳</tg-emoji> <b>Карта Сбербанк:</b>\n'
                    f"<code>2202208555983213</code>\n\n"
                    f'<tg-emoji emoji-id="{EMOJI_PHONE}">📱</tg-emoji> <b>По номеру телефона:</b>\n'
                    f"<code>+7 952 321-66-09</code>\n\n"
                    f"Нажмите на номер или карту, чтобы скопировать."
                )
                
                edit_message(chat_id, message_id, payment_text, payment_menu(), parse_mode="HTML")
                answer_callback(cb_id)
                return
            
            # ---- ОПЛАТА ----
            if data == "copy_card":
                answer_callback(cb_id, "✅ Номер карты скопирован!")
                send_message(chat_id, "<code>2202208555983213</code>", parse_mode="HTML")
                return
            
            if data == "copy_phone":
                answer_callback(cb_id, "✅ Номер телефона скопирован!")
                send_message(chat_id, "<code>+7 952 321-66-09</code>", parse_mode="HTML")
                return
            
            if data == "i_paid":
                cart = user_data[user_id]["cart"]
                total_uc, total_price = get_cart_total(cart)
                username = get_user_name(chat_id)
                user_mention = f'<a href="tg://user?id={chat_id}">{username}</a>'
                
                cart_text = ""
                for k, v in cart.items():
                    cart_text += f"• {k} UC x {v} = {UC_PRICES.get(k, 0) * v}₽\n"
                
                # Сохраняем заказ
                order_id = f"{chat_id}_{int(time.time())}"
                orders[order_id] = {
                    "user_id": chat_id,
                    "cart": cart,
                    "total_uc": total_uc,
                    "total_price": total_price,
                    "username": username,
                    "status": "waiting_confirmation"
                }
                
                # Отправляем владельцу
                owner_text = (
                    f"💰 <b>ПОДТВЕРЖДЕНИЕ ОПЛАТЫ</b>\n\n"
                    f"👤 Покупатель: {user_mention}\n"
                    f"📦 Товары:\n{cart_text}\n"
                    f"💰 Итого: {total_price}₽\n\n"
                    f"❓ Деньги пришли?"
                )
                
                send_message(OWNER_ID, owner_text, owner_confirm_menu(order_id), parse_mode="HTML")
                
                answer_callback(cb_id, "✅ Запрос на подтверждение отправлен!")
                edit_message(chat_id, message_id, "⏳ Ожидайте подтверждения оплаты...", main_menu())
                return
            
            if data == "cancel_payment":
                user_data[user_id]["cart"] = {}
                user_data[user_id]["step"] = "main"
                user_data[user_id]["temp"] = {}
                answer_callback(cb_id, "❌ Заказ отменён")
                edit_message(chat_id, message_id, "❌ Заказ отменён", main_menu())
                return
            
            # ---- ПОДТВЕРЖДЕНИЕ ОТ ВЛАДЕЛЬЦА ----
            if data.startswith("confirm_payment_"):
                order_id = data.replace("confirm_payment_", "")
                order = orders.get(order_id)
                if not order:
                    answer_callback(cb_id, "❌ Заказ не найден")
                    return
                
                user_id = order["user_id"]
                username = order["username"]
                total_price = order["total_price"]
                total_uc = order["total_uc"]
                cart = order["cart"]
                
                # Отправляем пользователю запрос PUBG ID
                send_message(
                    user_id,
                    f"✅ <b>Оплата подтверждена!</b>\n\n"
                    f"📦 Товар: {total_uc} UC\n"
                    f"💰 Сумма: {total_price}₽\n\n"
                    f"🆔 <b>Введите ваш PUBG ID:</b>\n"
                    f"<i>⚠️ Указывайте ID осторожно!\n"
                    f"Если вы укажете неверный ID, ваш товар будет отправлен другому человеку.</i>",
                    after_payment_menu(),
                    parse_mode="HTML"
                )
                
                user_data[str(user_id)]["step"] = "waiting_pubg_id"
                user_data[str(user_id)]["temp"]["order_id"] = order_id
                
                answer_callback(cb_id, "✅ Пользователь уведомлён")
                edit_message(chat_id, message_id, "✅ Пользователь уведомлён. Ожидает ввода PUBG ID", main_menu())
                return
            
            if data.startswith("reject_payment_"):
                order_id = data.replace("reject_payment_", "")
                order = orders.get(order_id)
                if not order:
                    answer_callback(cb_id, "❌ Заказ не найден")
                    return
                
                user_id = order["user_id"]
                
                send_message(
                    user_id,
                    "❌ <b>Оплата не подтверждена</b>\n\n"
                    "К сожалению, мы не получили ваш платёж.\n"
                    "Заказ отменён.",
                    main_menu(),
                    parse_mode="HTML"
                )
                
                user_data[str(user_id)]["cart"] = {}
                user_data[str(user_id)]["step"] = "main"
                user_data[str(user_id)]["temp"] = {}
                
                answer_callback(cb_id, "❌ Заказ отменён")
                edit_message(chat_id, message_id, "❌ Заказ отменён", main_menu())
                return
            
            # ---- ВЫПОЛНЕНИЕ ЗАКАЗА ВЛАДЕЛЬЦЕМ ----
            if data.startswith("order_done_"):
                order_id = data.replace("order_done_", "")
                order = orders.get(order_id)
                if not order:
                    answer_callback(cb_id, "❌ Заказ не найден")
                    return
                
                user_id = order["user_id"]
                total_uc = order["total_uc"]
                pubg_id = user_data[str(user_id)].get("temp", {}).get("pubg_id", "Не указан")
                
                # Отправляем пользователю
                send_message(
                    user_id,
                    f"✅ <b>Ваш заказ выполнен!</b>\n\n"
                    f"📦 Товар: {total_uc} UC\n"
                    f"🆔 PUBG ID: {pubg_id}\n\n"
                    f"🎉 Спасибо за покупку!\n"
                    f"Мы ценим ваше доверие.",
                    main_menu(),
                    parse_mode="HTML"
                )
                
                answer_callback(cb_id, "✅ Заказ выполнен!")
                edit_message(chat_id, message_id, f"✅ Заказ {order_id} выполнен!", main_menu())
                
                # Очищаем данные пользователя
                user_data[str(user_id)]["cart"] = {}
                user_data[str(user_id)]["step"] = "main"
                user_data[str(user_id)]["temp"] = {}
                return
            
            # ---- ПОПУЛЯРНОСТЬ ----
            if data == "popularity":
                edit_message(chat_id, message_id, "⭐️ Выберите количество популярности:", popularity_menu())
                answer_callback(cb_id)
                return
            
            if data.startswith("pop_"):
                amount = data.split("_")[1]
                formatted = f"{int(amount):,}".replace(",", " ")
                price = POPULARITY_PRICES.get(amount, 0)
                
                answer_callback(cb_id, f"✅ Выбрано {formatted} ПП!")
                
                # Добавляем в корзину как популярность
                user_data[user_id]["cart"][f"pop_{amount}"] = user_data[user_id]["cart"].get(f"pop_{amount}", 0) + 1
                
                send_message(
                    chat_id,
                    f"✅ Вы выбрали {formatted} ПП - {price}₽\n\n"
                    f"Популярность будет добавлена на ваш аккаунт.\n"
                    f"⏳ Время доставки: от 5 до 30 минут",
                    main_menu()
                )
                return
            
            # ---- ИНФОРМАЦИЯ ----
            if data == "info":
                text = (
                    "ℹ️ KRANZAYY UC BOT\n\n"
                    "Наш бот работает для вас "
                    f'<tg-emoji emoji-id="{EMOJI_HEART}">❤️‍🔥</tg-emoji>\n\n'
                    f'<tg-emoji emoji-id="{EMOJI_FIRE}">🌟</tg-emoji>'
                    f'<tg-emoji emoji-id="{EMOJI_SPARKLE}">✨</tg-emoji>'
                    f'<tg-emoji emoji-id="{EMOJI_SPARKLE}">✨</tg-emoji>'
                    f'<tg-emoji emoji-id="{EMOJI_STAR2}">💫</tg-emoji>\n\n'
                    "Наши ресурсы:\n"
                    f'<tg-emoji emoji-id="{EMOJI_SHOP}">🛒</tg-emoji> Магазин - https://t.me/kranzayyuc\n'
                    f'<tg-emoji emoji-id="{EMOJI_MEGAPHONE}">📢</tg-emoji> Канал - https://t.me/KRANZAYY_STORE\n'
                    f'<tg-emoji emoji-id="{EMOJI_METRO}">🏪</tg-emoji> Метро шоп - https://t.me/MetroShop_Kranzayy\n'
                    f'<tg-emoji emoji-id="{EMOJI_REVIEW}">⭐</tg-emoji> Отзывы - https://t.me/Kranzayy_OTZ\n\n'
                    f'<tg-emoji emoji-id="{EMOJI_DIAMOND}">💎</tg-emoji>'
                    f'<tg-emoji emoji-id="{EMOJI_DIAMOND}">💎</tg-emoji>'
                    f'<tg-emoji emoji-id="{EMOJI_DIAMOND}">💎</tg-emoji>'
                    f'<tg-emoji emoji-id="{EMOJI_DIAMOND}">💎</tg-emoji>\n\n'
                    f'<tg-emoji emoji-id="{EMOJI_SUPPORT}">🆘</tg-emoji> Техническая поддержка: @M_K_B_59'
                )
                edit_message(chat_id, message_id, text, main_menu(), parse_mode="HTML")
                answer_callback(cb_id)
                return
            
            # ---- НЕИЗВЕСТНО ----
            logger.warning(f"⚠️ Неизвестная кнопка: {data}")
            answer_callback(cb_id, "❌ Неизвестная команда")
    
    except Exception as e:
        logger.error(f"💥 ОШИБКА: {e}")
        logger.error(traceback.format_exc())

# ========== ЗАПУСК ==========

def main():
    offset = None
    logger.info("=" * 50)
    logger.info("🚀 БОТ ЗАПУЩЕН")
    logger.info(f"👤 Владелец: {OWNER_ID}")
    logger.info("💎 Только премиум-эмодзи")
    logger.info("=" * 50)
    
    while True:
        try:
            response = requests.get(
                f"{BASE_URL}/getUpdates",
                params={"timeout": 30, "offset": offset},
                timeout=35
            ).json()
            
            if response.get("ok"):
                for update in response.get("result", []):
                    handle_update(update)
                    offset = update["update_id"] + 1
            else:
                logger.error(f"❌ Ошибка: {response}")
            
            time.sleep(0.5)
        except Exception as e:
            logger.error(f"💥 Ошибка: {e}")
            time.sleep(10)

if __name__ == "__main__":
    main()
